import React, { createContext, useContext, useState, useEffect, useRef } from 'react';
import {
  collection, onSnapshot, addDoc, updateDoc, deleteDoc,
  doc, serverTimestamp
} from 'firebase/firestore';
import { db } from '../firebase';

const DataContext = createContext();

export const initialServices = [
  { id: '1', name: 'Basic Visit', price: 200, defaultSub: 'up to 2 pets' },
  { id: '2', name: 'Play & Visit', price: 250, defaultSub: 'up to 2 pets' },
  { id: '3', name: 'Twice-a-day Visit', price: 350, defaultSub: 'up to 2 pets' },
  { id: '4', name: 'Twice-a-day Play & Visit', price: 450, defaultSub: 'up to 2 pets' }
];

const loadLocal = (key, def) => {
  try { const v = localStorage.getItem(key); return v ? JSON.parse(v) : def; }
  catch { return def; }
};

export function DataProvider({ children }) {
  const [bookings,   setBookings]   = useState([]);
  const [clients,    setClients]    = useState([]);
  const [invoices,   setInvoices]   = useState([]);
  const [reminders,  setReminders]  = useState([]);
  const [services, setServicesState] = useState(() => loadLocal('kats_services', initialServices));
  const [loading,  setLoading]  = useState(true);
  const [syncStatus, setSyncStatus] = useState('connecting');

  // Use a ref to track resolution so it's immune to re-renders
  const resolvedRef = useRef(0);

  useEffect(() => {
    resolvedRef.current = 0;
    const timeout = setTimeout(() => {
      setLoading(false);
      setSyncStatus('offline');
    }, 8000);

    const done = () => {
      resolvedRef.current += 1;
      if (resolvedRef.current >= 4) {
        clearTimeout(timeout);
        setLoading(false);
      }
    };

    const handleError = (err) => {
      console.warn('Firestore error:', err?.message || err);
      setSyncStatus('offline');
      done();
    };

    const unsubBookings = onSnapshot(
      collection(db, 'bookings'),
      snap => {
        setBookings(snap.docs.map(d => ({ id: d.id, ...d.data() })));
        setSyncStatus('online');
        done();
      },
      handleError
    );

    const unsubClients = onSnapshot(
      collection(db, 'clients'),
      snap => { setClients(snap.docs.map(d => ({ id: d.id, ...d.data() }))); done(); },
      handleError
    );

    const unsubInvoices = onSnapshot(
      collection(db, 'invoices'),
      snap => { setInvoices(snap.docs.map(d => ({ id: d.id, ...d.data() }))); done(); },
      handleError
    );

    const unsubReminders = onSnapshot(
      collection(db, 'reminders'),
      snap => { setReminders(snap.docs.map(d => ({ id: d.id, ...d.data() }))); done(); },
      handleError
    );

    const handleOnline  = () => setSyncStatus('online');
    const handleOffline = () => setSyncStatus('offline');
    window.addEventListener('online',  handleOnline);
    window.addEventListener('offline', handleOffline);

    return () => {
      clearTimeout(timeout);
      unsubBookings(); unsubClients(); unsubInvoices(); unsubReminders();
      window.removeEventListener('online',  handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  useEffect(() => {
    localStorage.setItem('kats_services', JSON.stringify(services));
  }, [services]);

  // ── BOOKINGS ───────────────────────────────────────────────────────────────
  const addBooking = async (booking) => {
    const { id, ...data } = booking; // discard local id — Firestore generates its own
    await addDoc(collection(db, 'bookings'), { ...data, createdAt: serverTimestamp() });
  };
  const updateBooking = async (id, updates) => {
    const { id: _drop, createdAt, ...safeData } = updates;
    await updateDoc(doc(db, 'bookings', id), safeData);
  };
  const removeBooking = async (id) => await deleteDoc(doc(db, 'bookings', id));

  // ── CLIENTS ────────────────────────────────────────────────────────────────
  const addClient = async (client) => {
    const { id, ...data } = client;
    await addDoc(collection(db, 'clients'), { ...data, createdAt: serverTimestamp() });
  };
  const updateClient = async (id, updates) => {
    const { id: _drop, createdAt, ...safeData } = updates;
    await updateDoc(doc(db, 'clients', id), safeData);
  };
  const removeClient = async (id) => await deleteDoc(doc(db, 'clients', id));

  // ── INVOICES ───────────────────────────────────────────────────────────────
  const addInvoice = async (invoice) => {
    const { id, ...data } = invoice;
    await addDoc(collection(db, 'invoices'), { ...data, createdAt: serverTimestamp() });
  };
  const updateInvoice = async (id, updates) => {
    const { id: _drop, createdAt, ...safeData } = updates;
    await updateDoc(doc(db, 'invoices', id), safeData);
  };
  const removeInvoice = async (id) => await deleteDoc(doc(db, 'invoices', id));

  // ── REMINDERS ────────────────────────────────────────────────────────────────────────────
  const addReminder = async (text) => {
    await addDoc(collection(db, 'reminders'), { text, done: false, createdAt: serverTimestamp() });
  };
  const toggleReminder = async (id, current) => {
    await updateDoc(doc(db, 'reminders', id), { done: !current });
  };
  const removeReminder = async (id) => await deleteDoc(doc(db, 'reminders', id));

  // ── EXPORT / IMPORT ────────────────────────────────────────────────────────
  const exportData = () => {
    const data = { bookings, clients, services, invoices };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `Kat_CRM_Backup_${new Date().toISOString().split('T')[0]}.json`;
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 100);
  };

  const importData = async (jsonData) => {
    try {
      const data = JSON.parse(jsonData);
      const push = async (colName, items) => {
        for (const item of (items || [])) {
          const { id, createdAt, ...rest } = item;
          await addDoc(collection(db, colName), rest);
        }
      };
      await push('bookings', data.bookings);
      await push('clients',  data.clients);
      await push('invoices', data.invoices);
      if (data.services) setServicesState(data.services);
      alert('✅ Data imported! It will sync to all devices shortly.');
    } catch (e) {
      console.error(e);
      alert('❌ Error: Make sure it\'s a valid backup file.');
    }
  };

  return (
    <DataContext.Provider value={{
      bookings, addBooking, updateBooking, removeBooking,
      clients,  addClient,  updateClient,  removeClient,
      invoices, addInvoice, updateInvoice, removeInvoice,
      reminders, addReminder, toggleReminder, removeReminder,
      services, setServices: setServicesState,
      exportData, importData,
      loading, syncStatus
    }}>
      {children}
    </DataContext.Provider>
  );
}

export const useData = () => useContext(DataContext);
</file>

<file path="src/views/ClientsView.jsx">
import React, { useState } from 'react';
import { useData } from '../store/DataContext';
import { v4 as uuidv4 } from 'uuid';
import { PawPrint } from 'lucide-react';

// ─── SVG Pet Logos ────────────────────────────────────────────────────────────
const CatSvg = ({ color, size = 28 }) => (
