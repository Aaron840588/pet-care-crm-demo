import React, { useState } from 'react';
import { useData } from '../store/DataContext';
import { KeyRound, ReceiptText, CalendarCheck2, Users, TrendingUp, Clock, Plus, Check, Trash2 } from 'lucide-react';

// Shared date formatter — exported so other views can import it
export const fmtDate = (dateStr) => {
  if (!dateStr) return '—';
  const [y, m, d] = dateStr.split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('en-PH', {
    month: 'long', day: 'numeric', year: 'numeric'
  });
};

export default function DashboardView() {
  const { bookings, clients, invoices, reminders, addReminder, toggleReminder, removeReminder, updateInvoice } = useData();
  const [newReminder, setNewReminder] = useState('');

  const activeBookings  = bookings.filter(b => b.status === 'active').length;
  const totalClients    = clients.length;
  const upcomingCount   = bookings.filter(b => b.status === 'pending').length;
  const unpaidInvoices  = invoices.filter(i => (i.total - i.paid) > 0);
  const unpaidBalance   = unpaidInvoices.reduce((acc, inv) => acc + (inv.total - inv.paid), 0);
  const keysPending     = clients.filter(c => c.keyStatus === 'pending');

  const todayStr = new Date().toISOString().split('T')[0];
  const todaysSchedule = bookings.filter(b =>
    b.startDate <= todayStr && b.endDate >= todayStr && b.status !== 'done'
  );

  const upcoming = bookings
    .filter(b => b.status === 'pending')
    .sort((a, b) => new Date(a.startDate) - new Date(b.startDate))
    .slice(0, 4);

  const todayFull = new Date().toLocaleDateString('en-PH', {
    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
  });

  return (
    <div>
