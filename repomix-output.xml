    <ellipse cx="22" cy="30" rx="5" ry="6" fill="#222" />
    <ellipse cx="42" cy="30" rx="5" ry="6" fill="#222" />
    <ellipse cx="23" cy="29" rx="2" ry="2" fill="#fff" />
    <ellipse cx="43" cy="29" rx="2" ry="2" fill="#fff" />
