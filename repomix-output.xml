                    {c.keyDate && <div style={{ fontSize: '12px', marginBottom: '4px', color: '#444' }}><strong>Date Logged:</strong> {c.keyDate}</div>}
                    <div style={{ fontSize: '12px', color: '#444' }}><strong>Description:</strong> {c.keyNotes || <i>No visual description</i>}</div>
