                    {c.keyStatus === 'returned' && <span className="key-badge key-returned">Returned</span>}
                  </div>
                  
                  <div style={{ fontSize: '12px', color: 'var(--gray)', marginTop: '4px', lineHeight: 1.4 }}>
                    {c.address || <i>No pickup address provided</i>}
