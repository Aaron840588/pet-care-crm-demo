<file path="src/index.css">
/* ── GOOGLE FONTS now loaded via <link> in index.html for better performance ── */
/* @import removed — use preconnect + link tags instead */

/* ── DESIGN TOKENS ─────────────────────────────────────────────────────────── */
:root {
  --lime:       #d4e84a;
  --lime-dark:  #b3c732;
  --lime-pale:  #eef7a0;
  --lime-mid:   #c8de30;
  --black:      #1a1a1a;
  --dark:       #2c2c2c;
  --gray:       #6b6b6b;
  --gray-light: #e8e8e0;
  --light:      #f4f4ee;
  --white:      #ffffff;
  --red:        #d94f4f;
  --green:      #3fa85f;
  --orange:     #e08c30;
  --shadow:     0 2px 16px rgba(0,0,0,0.09);
  --font-display: 'Playfair Display', Georgia, serif;
  --font-body:    'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  /* iOS safe area padding */
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-top:    env(safe-area-inset-top, 0px);
}

/* ── RESET ─────────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── BODY ──────────────────────────────────────────────────────────────────── */
html { height: -webkit-fill-available; }
body {
  font-family: var(--font-body);
  background-color: var(--light);
  background-image: url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M12,18C12,15 14,13 16,13C18,13 20,15 20,18C20,21 18,23 16,23C14,23 12,21 12,18ZM6,24C6,22 8,20 10,20C12,20 14,22 14,24C14,26 12,28 10,28C8,28 6,26 6,24ZM22,24C22,22 24,20 26,20C28,20 30,22 30,24C30,26 28,28 26,28C24,28 22,26 22,24ZM16,25C16,25 20,29 20,33C20,35 18,36 16,36C14,36 12,35 12,33C12,29 16,25 16,25Z" fill="%23000" fill-opacity="0.015"/></svg>');
  color: var(--black);
  display: flex;
  min-height: 100vh;
  min-height: -webkit-fill-available;
  font-size: 14px;
  /* Critical: eliminates 300ms tap delay on ALL browsers */
  touch-action: manipulation;
  /* Prevent pull-to-refresh rubber band on iOS */
  overscroll-behavior: none;
  -webkit-text-size-adjust: 100%;
}

.app-container { display: flex; width: 100%; min-height: 100vh; min-height: 100dvh; }

/* ── SIDEBAR (desktop) ─────────────────────────────────────────────────────── */
.sidebar {
  width: 230px;
  min-height: 100vh;
  background: var(--black);
  position: fixed; top: 0; left: 0; z-index: 100;
  display: flex; flex-direction: column; padding-bottom: 20px;
  /* GPU layer for smooth animation */
  will-change: transform;
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}
.sb-brand { padding: 24px 22px 20px; border-bottom: 1px solid #2e2e2e; }
.sb-brand .logo { font-family: var(--font-display); font-size: 20px; color: var(--lime); font-weight: 700; line-height: 1.2; }
.sb-brand .logo span { font-style: italic; font-weight: 400; }
.sb-brand .sub { font-size: 11px; color: #666; margin-top: 3px; letter-spacing: .03em; }
.nav { padding: 14px 0; flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.nav-section { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: #444; padding: 14px 22px 6px; font-weight: 700; }
.nav-item {
  display: flex; align-items: center; gap: 10px; padding: 12px 22px;
  color: #999; cursor: pointer; font-size: 13px; font-weight: 500;
  border-left: 3px solid transparent; text-decoration: none;
  /* No CSS transition on mobile — causes lag */
  transition: color .12s, background .12s;
  /* Proper touch target min 44px */
  min-height: 44px;
}
.nav-item .ic { font-size: 15px; width: 20px; text-align: center; }
.nav-item:hover { color: #fff; background: #222; }
.nav-item.active { color: var(--lime); background: #1a1a1a; border-left-color: var(--lime); }
.sb-footer { padding: 16px 22px; border-top: 1px solid #222; font-size: 11px; color: #444; line-height: 1.6; }

/* ── SYNC PILL ─────────────────────────────────────────────────────────────── */
.sync-pill {
  position: fixed; bottom: 20px; right: 16px;
  border-radius: 20px; padding: 5px 12px; font-size: 11px; font-weight: 700;
  display: flex; align-items: center; gap: 5px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.12); z-index: 200;
}

/* ── MAIN CONTENT ──────────────────────────────────────────────────────────── */
.main-wrapper { flex: 1; margin-left: 230px; display: flex; flex-direction: column; min-height: 100vh; }
.main { padding: 30px 34px; max-width: 100%; flex: 1; }

/* ── PAGE HEADER ───────────────────────────────────────────────────────────── */
.ph { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 26px; gap: 16px; flex-wrap: wrap; }
.ph h2 { font-family: var(--font-display); font-size: 26px; font-weight: 700; line-height: 1.1; }
.ph p { color: var(--gray); font-size: 13px; margin-top: 3px; }
.ph-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

/* ── BUTTONS ───────────────────────────────────────────────────────────────── */
.btn {
  padding: 10px 18px; border-radius: 10px; border: none; cursor: pointer;
  font-family: var(--font-body); font-weight: 600; font-size: 13px;
  transition: background .12s, transform .1s, box-shadow .1s;
  display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
  /* Remove 300ms delay */
  touch-action: manipulation;
  /* Min touch target */
  min-height: 44px;
  -webkit-tap-highlight-color: transparent;
}
.btn:active { transform: scale(0.97); }
.btn-lime   { background: var(--lime); color: var(--black); }
.btn-lime:hover { background: var(--lime-dark); }
.btn-dark   { background: var(--black); color: #fff; }
.btn-dark:hover { background: #333; }
.btn-ghost  { background: #fff; color: var(--black); border: 1.5px solid #ddd; }
.btn-ghost:hover { border-color: var(--black); }
.btn-danger { background: #fff0f0; color: var(--red); border: 1.5px solid #f5cece; }
.btn-danger:hover { background: var(--red); color: #fff; border-color: var(--red); }
.btn-sm { padding: 7px 14px; font-size: 12px; border-radius: 8px; min-height: 36px; }
.btn-xs { padding: 5px 10px; font-size: 11px; border-radius: 6px; min-height: 32px; }

/* ── CARDS ─────────────────────────────────────────────────────────────────── */
.card {
  background: #fff; border-radius: 16px; padding: 22px;
  box-shadow: var(--shadow); margin-bottom: 22px;
  /* Use transform instead of margin for hover — GPU accelerated */
}
/* Only apply hover on non-touch devices */
@media (hover: hover) {
  .card:hover { transform: translateY(-2px); box-shadow: 0 4px 22px rgba(0,0,0,0.12); }
}
.card-title { font-family: var(--font-display); font-size: 15px; font-weight: 700; margin-bottom: 14px; }

/* ── STATS ROW ─────────────────────────────────────────────────────────────── */
.stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
.stat { background: #fff; border-radius: 14px; padding: 18px 20px; box-shadow: var(--shadow); }
.stat.lime { background: var(--lime); }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; color: var(--gray); }
.stat.lime .stat-label { color: #555; }
.stat-val { font-size: 28px; font-weight: 800; margin-top: 5px; line-height: 1; }
.stat-sub { font-size: 11px; color: var(--gray); margin-top: 3px; }

/* Hover only on pointer devices — no sticky hover on Android/iOS */
@media (hover: hover) and (pointer: fine) {
  .stat-card { transition: transform .18s, box-shadow .18s; cursor: default; }
  .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
}

/* Earnings 2-column layout */
.earnings-grid { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }

/* ── DASH GRID ─────────────────────────────────────────────────────────────── */
.dash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.list-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f4f4f0; }
.list-item:last-child { border-bottom: none; }
.date-badge { background: var(--lime-pale); border-radius: 8px; padding: 5px 10px; text-align: center; min-width: 50px; flex-shrink: 0; }
.date-badge .db-day { font-size: 18px; font-weight: 800; display: block; line-height: 1; }
.date-badge .db-mon { font-size: 10px; font-weight: 700; color: #666; text-transform: uppercase; }
.li-main { font-weight: 600; font-size: 13px; }
.li-sub  { font-size: 11px; color: var(--gray); margin-top: 1px; }

/* ── KEY BADGES ────────────────────────────────────────────────────────────── */
.key-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.key-received { background: #e6f7ed; color: var(--green); }
.key-pending  { background: #fff4e0; color: var(--orange); }
.key-returned { background: #f0f0f0; color: var(--gray); }
.key-none     { background: transparent; color: var(--gray); font-weight: 400; }

/* ── CLIENTS ───────────────────────────────────────────────────────────────── */
.clients-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
.client-card { background: #fff; border-radius: 16px; padding: 20px; box-shadow: var(--shadow); border-top: 4px solid var(--lime); display: flex; flex-direction: column; }
.cc-name    { font-size: 15px; font-weight: 700; }
.cc-contact { font-size: 12px; color: var(--gray); margin-top: 2px; }
.pets-row   { display: flex; flex-wrap: wrap; gap: 5px; margin: 10px 0; }
.pet-chip   { background: var(--lime-pale); border-radius: 20px; padding: 4px 12px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
.cc-notes   { background: #fafafa; border-radius: 8px; padding: 10px 12px; font-size: 12px; color: var(--gray); border-left: 3px solid var(--lime); line-height: 1.5; margin-bottom: 10px; flex: 1; }
.cc-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: auto; }

/* ── KEY SECTION ───────────────────────────────────────────────────────────── */
.key-section { background: var(--lime-pale); border-radius: 8px; padding: 10px 12px; margin: 8px 0; font-size: 12px; }
.key-section .ks-label { font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #555; margin-bottom: 5px; }
.key-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }

/* ── TABLE ─────────────────────────────────────────────────────────────────── */
.filter-bar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
.fchip {
  padding: 8px 16px; border-radius: 20px; border: 1.5px solid #ddd; background: #fff;
  cursor: pointer; font-size: 12px; font-weight: 600; transition: background .1s, border-color .1s;
  touch-action: manipulation; -webkit-tap-highlight-color: transparent; min-height: 36px;
}
.fchip.active { background: var(--lime); border-color: var(--lime); }
.table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
table { width: 100%; border-collapse: collapse; min-width: 600px; }
thead tr { background: var(--black); color: #fff; }
thead th { padding: 12px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; }
tbody tr { border-bottom: 1px solid #f2f2ee; background: #fff; }
tbody tr:hover { background: #fafaf5; }
tbody td { padding: 13px 14px; font-size: 13px; vertical-align: middle; }
.badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.b-active  { background: #e6f7ed; color: var(--green); }
.b-pending { background: #fff4e0; color: var(--orange); }
.b-done    { background: #f0f0f0; color: var(--gray); }
.empty-row td { text-align: center; color: var(--gray); padding: 40px; font-style: italic; }

/* ── TIME CHIPS ────────────────────────────────────────────────────────────── */
.time-chip  { background: #f0f4ff; border-radius: 6px; padding: 3px 8px; font-size: 11px; font-weight: 600; color: #4455aa; display: inline-block; margin: 2px; }
.time-flex  { background: var(--lime-pale); border-radius: 6px; padding: 3px 8px; font-size: 11px; color: #555; display: inline-flex; align-items: center; gap: 4px; }

/* ── INVOICE ───────────────────────────────────────────────────────────────── */
.inv-layout { display: grid; grid-template-columns: 1fr 400px; gap: 22px; align-items: start; }
.inv-preview { background: #fff; border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; position: relative; }
.inv-preview-inner { padding: 32px 36px; }
.inv-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; opacity: .07; background-image: radial-gradient(circle, var(--lime) 1.5px, transparent 1.5px); background-size: 22px 22px; }
.inv-z { position: relative; z-index: 1; }
.inv-head { text-align: center; margin-bottom: 18px; }
.inv-head .inv-big { font-family: var(--font-display); font-size: 42px; font-weight: 700; letter-spacing: -.02em; line-height: 1; }
.inv-head .inv-biz { font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--gray); margin-top: 3px; }
.inv-gcash-pill { background: var(--lime); border-radius: 30px; padding: 5px 20px; display: inline-block; font-weight: 700; font-size: 13px; margin-top: 8px; }
.inv-to { margin: 18px 0 14px; font-size: 13px; line-height: 1.7; }
.inv-to .it-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }
.inv-to .it-name  { font-weight: 700; font-size: 14px; }
.inv-to .it-pets  { color: var(--gray); }
.inv-img-area { text-align: center; margin-bottom: 12px; min-height: 50px; }
.inv-img-area img { max-width: 100%; max-height: 100px; border-radius: 8px; object-fit: contain; }
.inv-tbl { width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 13px; min-width: 0; }
.inv-tbl thead { background: var(--gray-light); }
.inv-tbl th { padding: 8px 12px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; text-align: center; font-weight: 700; background: #e5e5dc; }
.inv-tbl th:first-child { text-align: left; }
.inv-tbl td { padding: 10px 12px; text-align: center; border-bottom: 1px solid #f0f0e8; }
.inv-tbl td:first-child { text-align: left; }
.inv-tbl .discount-row td { color: var(--red); }
.inv-strike { text-decoration: line-through; color: #aaa; font-size: 11px; margin-right: 4px; }
.inv-discount-tag { font-size: 10px; font-weight: 700; color: var(--red); display: block; margin-top: 1px; }
.inv-totals { margin-left: auto; width: 230px; margin-top: 8px; }
.inv-total-line { font-size: 18px; font-weight: 700; text-align: right; margin-bottom: 8px; }
.inv-sum-row { display: flex; justify-content: space-between; padding: 9px 14px; margin-bottom: 5px; border-radius: 6px; font-weight: 600; font-size: 13px; }
.inv-sum-paid    { background: #f0f0e8; }
.inv-sum-balance { background: var(--black); color: #fff; border-radius: 8px; }
.inv-thanks { text-align: center; margin-top: 18px; font-family: var(--font-display); font-style: italic; font-size: 22px; color: var(--dark); }
.inv-form { background: #fff; border-radius: 14px; padding: 22px; box-shadow: var(--shadow); position: sticky; top: 20px; max-height: calc(100vh - 60px); overflow-y: auto; -webkit-overflow-scrolling: touch; }
.inv-form .if-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; margin-bottom: 16px; }
.inv-form hr { border: none; border-top: 1px solid #eee; margin: 14px 0; }
.discount-row-item { display: grid; grid-template-columns: 1fr auto auto; gap: 6px; align-items: center; margin-bottom: 6px; padding: 8px; background: #fafafa; border-radius: 8px; border: 1px solid #eee; }

/* ── MODALS ────────────────────────────────────────────────────────────────── */
.overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 500;
  display: flex; align-items: flex-end; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity .2s;
}
.overlay.open { opacity: 1; pointer-events: all; }
.modal {
  background: #fff; border-radius: 20px 20px 0 0; padding: 28px 24px;
  width: 100%; max-width: 580px; max-height: 92dvh; overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  transform: translateY(100%); transition: transform .28s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8px 40px rgba(0,0,0,.2);
  /* iOS safe area */
  padding-bottom: calc(28px + var(--safe-bottom));
}
.overlay.open .modal { transform: translateY(0); }
.modal-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; margin-bottom: 18px; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f0f0f0; }

/* ── FORMS ─────────────────────────────────────────────────────────────────── */
.fg { margin-bottom: 14px; }
.fg label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--gray); margin-bottom: 5px; }
.fg input, .fg select, .fg textarea {
  width: 100%; padding: 11px 13px; border: 1.5px solid #ddd; border-radius: 10px;
  font-family: var(--font-body); font-size: 16px; /* 16px prevents iOS zoom on focus */
  background: #fafafa; color: var(--black);
  transition: border-color .15s;
  -webkit-appearance: none; appearance: none;
}
.fg input:focus, .fg select:focus, .fg textarea:focus { outline: none; border-color: var(--lime-dark); background: #fff; }
.fg textarea { resize: vertical; min-height: 72px; line-height: 1.5; font-size: 14px; }
.fg .hint { font-size: 11px; color: var(--gray); margin-top: 3px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

/* ── BOTTOM NAVIGATION BAR ─────────────────────────────────────────────────── */
.bottom-nav {
  display: none; /* Hidden on desktop */
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
  background: var(--black);
  border-top: 1px solid #2a2a2a;
  /* iOS safe area for home indicator */
  padding-bottom: var(--safe-bottom);
  box-shadow: 0 -4px 20px rgba(0,0,0,0.2);
}
.bn-item {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; padding: 10px 4px; flex: 1;
  color: #666; background: none; border: none; cursor: pointer;
  font-family: var(--font-body); font-size: 10px; font-weight: 600;
  transition: color .12s;
  touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  min-height: 54px;
}
.bn-item.active { color: var(--lime); }
.bn-item svg { flex-shrink: 0; }

/* ── OFFLINE BANNER ─────────────────────────────────────────────────────────── */
.offline-banner {
  display: flex; align-items: center; gap: 10px;
  background: #fff4e0; border-bottom: 2px solid #f5c87a;
  padding: 10px 20px; font-size: 13px; font-weight: 600; color: #7a5200;
  position: sticky; top: 0; z-index: 50;
}
.offline-dismiss {
  background: none; border: none; cursor: pointer; color: #7a5200;
  padding: 4px; border-radius: 6px; display: flex; align-items: center;
  touch-action: manipulation; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

/* ── SCROLLBAR — Opera GX + Chrome + Chromium ──────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #aaa; }
* { scrollbar-width: thin; scrollbar-color: #ccc transparent; }

/* ── MEDIA QUERIES ─────────────────────────────────────────────────────────── */

/* Tablet - invoice stacks */
@media (max-width: 990px) {
  .inv-layout { grid-template-columns: 1fr; }
  .inv-form { position: static; max-height: none; order: 1; }
  .inv-preview { order: 2; margin-top: 20px; }
}

/* Mobile (768px and below) */
@media (max-width: 768px) {
  /* Hide desktop sidebar, show bottom nav */
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .main-wrapper { margin-left: 0; }
  .bottom-nav { display: flex; }
  .sync-pill { display: none; }

  /* Content padding — leave room for bottom nav + iOS home bar */
  .main { padding: 16px 14px calc(70px + var(--safe-bottom) + 8px) 14px; }

  /* Stats: 2 columns on mobile */
  .stats-row { grid-template-columns: 1fr 1fr; gap: 10px; }
  .stat-val { font-size: 22px; }

  /* Dashboard grid: 1 column */
  .dash-grid { grid-template-columns: 1fr; gap: 14px; }

  /* Earnings responsive */
  .earnings-grid { grid-template-columns: 1fr !important; }

  /* Clients: 1 column */
  .clients-grid { grid-template-columns: 1fr; }

  /* Forms: 1 column */
  .form-row { grid-template-columns: 1fr; }

  /* Page header */
  .ph { flex-direction: column; align-items: stretch; margin-bottom: 16px; }
  .ph h2 { font-size: 22px; }
  .ph-actions { margin-top: 8px; justify-content: flex-start; }
  .ph-actions .btn { flex: 1; justify-content: center; }

  /* Invoice */
  .inv-preview-inner { padding: 18px 14px; }
  .inv-head .inv-big { font-size: 28px; }
  .inv-totals { width: 100%; }

  /* Modal: full bottom sheet */
  .modal { max-height: 95dvh; border-radius: 20px 20px 0 0; }

  /* Disable hover on touch — prevents sticky hover state bug on Android/iOS */
  @media (hover: none) {
    .card:hover { transform: none !important; box-shadow: var(--shadow) !important; }
    .btn:hover { background: initial; }
    .nav-item:hover { color: #999; background: transparent; }
  }
}

/* Very small phones */
@media (max-width: 380px) {
  .main { padding: 12px 10px calc(70px + var(--safe-bottom) + 8px) 10px; }
  .stats-row { grid-template-columns: 1fr 1fr; gap: 8px; }
  .stat { padding: 14px 12px; }
  .stat-val { font-size: 20px; }
}
