        flexWrap: 'wrap',
        gap: '16px',
        boxShadow: '0 8px 32px rgba(0,0,0,0.18)'
      }}>
        <div>
          <div style={{ fontSize: '13px', color: 'var(--lime)', fontWeight: 700, letterSpacing: '.06em', textTransform: 'uppercase', marginBottom: '6px' }}>
            🐾 Pet-sitting Dashboard
          </div>
          <h2 style={{ fontFamily: 'var(--font-display)', fontSize: '28px', color: '#fff', fontWeight: 700, lineHeight: 1.1, marginBottom: '6px' }}>
            Good day, Kat!
          </h2>
          <p style={{ color: '#888', fontSize: '13px' }}>{todayFull}</p>
        </div>
        <div style={{ background: 'var(--lime)', borderRadius: '14px', padding: '14px 22px', textAlign: 'center', minWidth: '120px' }}>
          <div style={{ fontSize: '11px', fontWeight: 800, textTransform: 'uppercase', letterSpacing: '.06em', color: '#555', marginBottom: '4px' }}>Active Today</div>
          <div style={{ fontSize: '36px', fontWeight: 800, lineHeight: 1, color: 'var(--black)' }}>{todaysSchedule.length}</div>
          <div style={{ fontSize: '11px', color: '#666', marginTop: '2px' }}>sitting{todaysSchedule.length !== 1 ? 's' : ''}</div>
        </div>
      </div>

      {/* ── STAT CARDS ── */}
      <div className="stats-row" style={{ marginBottom: '22px' }}>
        {[
          { icon: Users,         label: 'Clients',        val: totalClients,             sub: 'total registered',   color: '#4a90d9', bg: '#eef4fc' },
          { icon: CalendarCheck2,label: 'Upcoming',        val: upcomingCount,            sub: 'bookings queued',    color: '#e08c30', bg: '#fff8ee' },
          { icon: TrendingUp,    label: 'Unpaid Balance',  val: `₱${unpaidBalance}`,     sub: 'to collect',         color: '#d94f4f', bg: '#fff0f0' },
          { icon: KeyRound,      label: 'Keys Pending',    val: keysPending.length,       sub: 'not yet received',   color: '#9b59b6', bg: '#f5eeff' },
        ].map(({ icon: Icon, label, val, sub, color, bg }) => (
          <div key={label} className="stat-card" style={{
            background: '#fff',
            borderRadius: '14px',
            padding: '18px 20px',
            boxShadow: 'var(--shadow)',
            display: 'flex',
            alignItems: 'flex-start',
            gap: '14px',
          }}>
            <div style={{ background: bg, borderRadius: '10px', padding: '10px', flexShrink: 0 }}>
              <Icon size={20} color={color} />
            </div>
            <div>
              <div style={{ fontSize: '10px', fontWeight: 800, textTransform: 'uppercase', letterSpacing: '.06em', color: 'var(--gray)', marginBottom: '2px' }}>{label}</div>
              <div style={{ fontSize: '22px', fontWeight: 800, lineHeight: 1.1 }}>{val}</div>
              <div style={{ fontSize: '11px', color: 'var(--gray)', marginTop: '2px' }}>{sub}</div>
            </div>
          </div>
        ))}
      </div>

      {/* ── MAIN GRID ── */}
      <div className="dash-grid">

        {/* TODAY'S SCHEDULE */}
        <div className="card" style={{ margin: 0, borderTop: '4px solid var(--lime)' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>
            <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '15px' }}>
              📅 Today's Schedule
            </div>
            <span style={{ background: 'var(--lime)', borderRadius: '20px', padding: '3px 10px', fontSize: '11px', fontWeight: 700 }}>
              {todaysSchedule.length} visit{todaysSchedule.length !== 1 ? 's' : ''}
            </span>
          </div>

          {todaysSchedule.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '24px 0', color: 'var(--gray)' }}>
              <CalendarCheck2 size={32} style={{ margin: '0 auto 8px', opacity: .3 }} />
              <p style={{ fontSize: '13px' }}>No visits today. Enjoy your rest! 🐾</p>
            </div>
          ) : todaysSchedule.map(b => (
            <div key={b.id} className="list-item">
              <div style={{ background: 'var(--lime)', borderRadius: '10px', padding: '8px 10px', flexShrink: 0 }}>
                <Clock size={18} color="var(--black)" />
              </div>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div className="li-main">{b.clientName}</div>
                <div className="li-sub">{b.timeText || 'Time not specified'}</div>
                <div style={{ fontSize: '11px', color: 'var(--orange)', fontWeight: 600, marginTop: '2px' }}>
                  Ends: {fmtDate(b.endDate)}
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* UPCOMING BOOKINGS */}
        <div className="card" style={{ margin: 0 }}>
          <div className="card-title">🗓 Upcoming Bookings</div>
          {upcoming.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '24px 0', color: 'var(--gray)' }}>
              <CalendarCheck2 size={32} style={{ margin: '0 auto 8px', opacity: .3 }} />
              <p style={{ fontSize: '13px' }}>No upcoming bookings yet.</p>
            </div>
          ) : upcoming.map(b => {
            const [y, mo, d] = b.startDate.split('-').map(Number);
            return (
              <div key={b.id} className="list-item">
                <div className="date-badge">
                  <div className="db-day">{d}</div>
                  <div className="db-mon">{new Date(y, mo-1, d).toLocaleString('default', { month: 'short' }).toUpperCase()}</div>
                </div>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div className="li-main">{b.clientName}</div>
                  <div className="li-sub">{b.service.split('|')[0]}</div>
                  <div className="li-sub">{fmtDate(b.startDate)} → {fmtDate(b.endDate)}</div>
                </div>
              </div>
            );
          })}
        </div>

        {/* KEYS TO COLLECT */}
        <div className="card" style={{ margin: 0 }}>
          <div className="card-title">🔑 Keys to Collect</div>
          {keysPending.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '24px 0', color: 'var(--gray)' }}>
              <KeyRound size={32} style={{ margin: '0 auto 8px', opacity: .3 }} />
              <p style={{ fontSize: '13px' }}>All keys received!</p>
            </div>
          ) : keysPending.map(c => (
            <div key={c.id} className="list-item">
              <div style={{ background: '#fff4e0', borderRadius: '10px', padding: '8px 10px', flexShrink: 0 }}>
                <KeyRound size={18} color="var(--orange)" />
              </div>
              <div>
                <div className="li-main">{c.name}</div>
                <div className="li-sub">{c.address || 'No address on file'}</div>
              </div>
            </div>
          ))}
        </div>

        {/* UNPAID INVOICES — with Mark Paid quick action */}
        <div className="card" style={{ margin: 0 }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>
            <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '15px' }}>💸 Unpaid Invoices</div>
            {unpaidBalance > 0 && (
              <span style={{ background: '#fff0f0', color: 'var(--red)', borderRadius: '20px', padding: '3px 10px', fontSize: '11px', fontWeight: 800 }}>
                ₱{unpaidBalance} total
              </span>
            )}
          </div>
          {unpaidInvoices.length === 0 ? (
            <div style={{ textAlign: 'center', padding: '24px 0', color: 'var(--gray)' }}>
              <ReceiptText size={32} style={{ margin: '0 auto 8px', opacity: .3 }} />
              <p style={{ fontSize: '13px' }}>All invoices cleared! 🎉</p>
            </div>
          ) : unpaidInvoices.map(i => (
            <div key={i.id} className="list-item">
              <div style={{ background: '#fff0f0', borderRadius: '10px', padding: '8px 10px', flexShrink: 0 }}>
                <ReceiptText size={18} color="var(--red)" />
              </div>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div className="li-main">{i.toName}</div>
                <div className="li-sub">Balance: <strong style={{ color: 'var(--red)' }}>₱{i.total - i.paid}</strong></div>
              </div>
              <button
                className="btn btn-xs btn-lime"
                style={{ flexShrink: 0 }}
                onClick={() => {
                  if (window.confirm(`Mark ₱${i.total - i.paid} from ${i.toName} as fully paid?`)) {
                    updateInvoice(i.id, { paid: i.total });
                  }
                }}
              >
                <Check size={11} /> Paid
              </button>
            </div>
          ))}
        </div>

        {/* REMINDERS / STICKY NOTES */}
        <div className="card" style={{ margin: 0, gridColumn: '1 / -1' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '14px', flexWrap: 'wrap', gap: '8px' }}>
            <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '15px' }}>📝 Quick Reminders</div>
            <span style={{ fontSize: '11px', color: 'var(--gray)' }}>{reminders.filter(r => !r.done).length} pending</span>
          </div>

          {/* Add reminder input */}
          <div style={{ display: 'flex', gap: '8px', marginBottom: '14px' }}>
            <input
              value={newReminder}
              onChange={e => setNewReminder(e.target.value)}
              onKeyDown={e => {
                if (e.key === 'Enter' && newReminder.trim()) {
                  addReminder(newReminder.trim());
                  setNewReminder('');
                }
              }}
              placeholder="Add a reminder… (press Enter)"
              style={{
                flex: 1, padding: '10px 14px', border: '1.5px solid #ddd', borderRadius: '10px',
                fontSize: '16px', fontFamily: 'var(--font-body)', background: '#fafafa',
                color: 'var(--black)'
              }}
            />
            <button
              className="btn btn-lime btn-sm"
              onClick={() => { if (newReminder.trim()) { addReminder(newReminder.trim()); setNewReminder(''); } }}
            >
              <Plus size={16} /> Add
            </button>
          </div>

          {/* Reminders list */}
          {reminders.length === 0 ? (
            <p style={{ color: 'var(--gray)', fontSize: '13px', fontStyle: 'italic' }}>No reminders yet. Add one above!</p>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
              {[...reminders]
                .sort((a, b) => (a.done === b.done ? 0 : a.done ? 1 : -1))
                .map(r => (
                  <div key={r.id} style={{
                    display: 'flex', alignItems: 'center', gap: '10px',
                    padding: '10px 12px', borderRadius: '10px',
                    background: r.done ? '#f8f8f8' : '#fffef5',
                    border: `1.5px solid ${r.done ? '#eee' : 'var(--lime)'}`,
                    transition: 'all .15s'
                  }}>
                    <button
                      onClick={() => toggleReminder(r.id, r.done)}
                      style={{
                        width: '22px', height: '22px', borderRadius: '50%', flexShrink: 0, border: 'none',
                        cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center',
                        background: r.done ? 'var(--green)' : 'transparent',
                        border: r.done ? 'none' : '2px solid #ccc',
                        transition: 'all .15s'
                      }}
                    >
                      {r.done && <Check size={12} color="#fff" />}
                    </button>
                    <span style={{
                      flex: 1, fontSize: '13px', fontWeight: 500,
                      textDecoration: r.done ? 'line-through' : 'none',
                      color: r.done ? 'var(--gray)' : 'var(--black)'
                    }}>{r.text}</span>
                    <button
                      onClick={() => removeReminder(r.id)}
                      style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#ccc', padding: '4px', borderRadius: '6px' }}
                    >
                      <Trash2 size={13} />
                    </button>
                  </div>
                ))}
            </div>
          )}
        </div>

      </div>
    </div>
  );
}
</file>

<file path="src/views/EarningsView.jsx">
import React, { useState } from 'react';
import { useData } from '../store/DataContext';
import {
  TrendingUp, ChevronUp, ChevronDown, ArrowRight,
  CircleDollarSign, CheckCircle
} from 'lucide-react';

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

const fmtMoney = (n) => `₱${Number(n || 0).toLocaleString('en-PH')}`;

export default function EarningsView() {
  const { invoices, clients, bookings } = useData();

  const now = new Date();
  const [selectedMonth, setSelectedMonth] = useState(now.getMonth());
  const [selectedYear, setSelectedYear] = useState(now.getFullYear());

  // Build last 6 months of data
  const last6 = Array.from({ length: 6 }, (_, i) => {
    const d = new Date(now.getFullYear(), now.getMonth() - (5 - i), 1);
    return { year: d.getFullYear(), month: d.getMonth(), label: MONTHS[d.getMonth()] };
  });

  const getMonthInvoices = (year, month) =>
    invoices.filter(inv => {
      const s = inv.dateSaved;
      if (!s) return false;
      const d = new Date(s);
      return d.getFullYear() === year && d.getMonth() === month;
    });

  const monthlyData = last6.map(({ year, month, label }) => {
    const invs = getMonthInvoices(year, month);
    const total = invs.reduce((s, i) => s + (i.total || 0), 0);
    const collected = invs.reduce((s, i) => s + (i.paid || 0), 0);
    return { label, year, month, total, collected, count: invs.length };
  });

  const maxTotal = Math.max(...monthlyData.map(m => m.total), 1);

  // Selected month detail
  const selInvoices = getMonthInvoices(selectedYear, selectedMonth);
  const selTotal = selInvoices.reduce((s, i) => s + (i.total || 0), 0);
  const selCollected = selInvoices.reduce((s, i) => s + (i.paid || 0), 0);
  const selOutstanding = selTotal - selCollected;

  // All-time stats
  const allTotal = invoices.reduce((s, i) => s + (i.total || 0), 0);
  const allCollected = invoices.reduce((s, i) => s + (i.paid || 0), 0);
  const allOutstanding = allTotal - allCollected;

  // Top clients by total invoiced
  const clientTotals = clients.map(c => {
    const cInvs = invoices.filter(i => i.toName === c.name);
    return {
      name: c.name,
      total: cInvs.reduce((s, i) => s + (i.total || 0), 0),
      paid: cInvs.reduce((s, i) => s + (i.paid || 0), 0),
      count: cInvs.length
    };
  }).filter(c => c.count > 0).sort((a, b) => b.total - a.total).slice(0, 5);

  // Month-over-month change
  const curr = monthlyData[5];
  const prev = monthlyData[4];
  const change = prev.total > 0 ? ((curr.total - prev.total) / prev.total * 100).toFixed(0) : null;

  return (
    <>
      <div className="ph">
        <div>
          <h2>Earnings Summary</h2>
          <p>Monthly income overview and client breakdown</p>
        </div>
      </div>

      {/* ── ALL-TIME STATS ── */}
      <div className="stats-row" style={{ marginBottom: '22px' }}>
        {[
          { label: 'Total Invoiced', val: fmtMoney(allTotal), sub: 'all time', color: '#4a90d9', bg: '#eef4fc' },
          { label: 'Total Collected', val: fmtMoney(allCollected), sub: 'payments received', color: '#3fa85f', bg: '#e6f7ed' },
          { label: 'Outstanding', val: fmtMoney(allOutstanding), sub: 'still to collect', color: '#d94f4f', bg: '#fff0f0' },
          { label: 'This Month', val: fmtMoney(curb(selTotal)), sub: MONTHS[selectedMonth] + ' ' + selectedYear, color: '#9b59b6', bg: '#f5eeff' },
        ].map(({ label, val, sub, color, bg }) => (
          <div key={label} style={{ background: '#fff', borderRadius: '14px', padding: '18px 20px', boxShadow: 'var(--shadow)', display: 'flex', alignItems: 'flex-start', gap: '14px' }}>
            <div style={{ background: bg, borderRadius: '10px', padding: '10px', flexShrink: 0 }}>
              <CircleDollarSign size={20} color={color} />
            </div>
            <div>
              <div style={{ fontSize: '10px', fontWeight: 800, textTransform: 'uppercase', letterSpacing: '.06em', color: 'var(--gray)', marginBottom: '2px' }}>{label}</div>
              <div style={{ fontSize: '20px', fontWeight: 800, lineHeight: 1.1 }}>{val}</div>
              <div style={{ fontSize: '11px', color: 'var(--gray)', marginTop: '2px' }}>{sub}</div>
            </div>
          </div>
        ))}
      </div>

      <div className="earnings-grid">

        {/* ── 6-MONTH BAR CHART ── */}
        <div className="card" style={{ margin: 0 }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '20px', flexWrap: 'wrap', gap: '8px' }}>
            <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '16px' }}>📈 Monthly Revenue</div>
            {change !== null && (
              <div style={{
                display: 'flex', alignItems: 'center', gap: '4px', padding: '4px 12px',
                borderRadius: '20px', fontSize: '12px', fontWeight: 700,
                background: Number(change) >= 0 ? '#e6f7ed' : '#fff0f0',
                color: Number(change) >= 0 ? 'var(--green)' : 'var(--red)'
              }}>
                {Number(change) >= 0 ? <ChevronUp size={14} /> : <ChevronDown size={14} />}
                {Math.abs(change)}% vs last month
              </div>
            )}
          </div>

          {/* Bar chart */}
          <div style={{ display: 'flex', gap: '10px', alignItems: 'flex-end', height: '180px', marginBottom: '12px' }}>
            {monthlyData.map((m, i) => {
              const totalH = Math.round((m.total / maxTotal) * 160);
              const collH = Math.round((m.collected / maxTotal) * 160);
              const isSelected = m.month === selectedMonth && m.year === selectedYear;
              return (
                <div
                  key={i}
                  style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px', cursor: 'pointer' }}
                  onClick={() => { setSelectedMonth(m.month); setSelectedYear(m.year); }}
                >
                  <div style={{ fontSize: '10px', fontWeight: 700, color: isSelected ? 'var(--black)' : 'var(--gray)' }}>
                    {m.total > 0 ? fmtMoney(m.total) : '—'}
                  </div>
                  <div style={{ width: '100%', display: 'flex', gap: '3px', alignItems: 'flex-end', height: '160px' }}>
                    {/* Total bar */}
                    <div style={{
                      flex: 1, height: `${totalH}px`, borderRadius: '6px 6px 0 0',
                      background: isSelected ? 'var(--lime-dark)' : 'var(--lime-pale)',
                      transition: 'all .2s', minHeight: m.total > 0 ? '4px' : '0'
                    }} />
                    {/* Collected bar */}
                    {m.collected > 0 && (
                      <div style={{
                        flex: 1, height: `${collH}px`, borderRadius: '6px 6px 0 0',
                        background: isSelected ? 'var(--green)' : '#b5e6c5',
                        transition: 'all .2s', minHeight: '4px'
                      }} />
                    )}
                  </div>
                  <div style={{
                    fontSize: '11px', fontWeight: isSelected ? 800 : 500,
                    color: isSelected ? 'var(--black)' : 'var(--gray)',
                    background: isSelected ? 'var(--lime)' : 'transparent',
                    padding: '2px 6px', borderRadius: '6px'
                  }}>{m.label}</div>
                </div>
              );
            })}
          </div>

          {/* Legend */}
          <div style={{ display: 'flex', gap: '16px', fontSize: '11px', color: 'var(--gray)' }}>
            <span style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>
              <span style={{ width: '12px', height: '12px', background: 'var(--lime-dark)', borderRadius: '3px', display: 'inline-block' }} />
              Invoiced
            </span>
            <span style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>
              <span style={{ width: '12px', height: '12px', background: 'var(--green)', borderRadius: '3px', display: 'inline-block' }} />
              Collected
            </span>
          </div>
        </div>

        {/* ── SELECTED MONTH DETAIL ── */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          <div className="card" style={{ margin: 0 }}>
            <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '16px', marginBottom: '14px' }}>
              {MONTHS[selectedMonth]} {selectedYear}
            </div>
            {selInvoices.length === 0 ? (
              <p style={{ color: 'var(--gray)', fontSize: '13px', fontStyle: 'italic' }}>No invoices this month.</p>
            ) : (
              <>
                {[
                  { label: 'Invoiced', val: selTotal, color: 'var(--black)' },
                  { label: 'Collected', val: selCollected, color: 'var(--green)' },
                  { label: 'Outstanding', val: selOutstanding, color: selOutstanding > 0 ? 'var(--red)' : 'var(--green)' },
                ].map(row => (
                  <div key={row.label} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '10px 0', borderBottom: '1px solid #f4f4f0' }}>
                    <span style={{ fontSize: '13px', color: 'var(--gray)', fontWeight: 600 }}>{row.label}</span>
                    <span style={{ fontWeight: 800, fontSize: '15px', color: row.color }}>{fmtMoney(row.val)}</span>
                  </div>
                ))}
                <div style={{ marginTop: '14px' }}>
                  <div style={{ fontSize: '11px', fontWeight: 700, textTransform: 'uppercase', color: 'var(--gray)', marginBottom: '8px' }}>Invoices this month</div>
                  {selInvoices.map(inv => {
                    const bal = inv.total - inv.paid;
                    return (
                      <div key={inv.id} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '6px 0', fontSize: '12px', borderBottom: '1px solid #f8f8f8' }}>
                        <div>
                          <div style={{ fontWeight: 600 }}>{inv.toName}</div>
                          <div style={{ color: 'var(--gray)', fontSize: '11px' }}>{inv.baseServiceName || '—'}</div>
                        </div>
                        <div style={{ textAlign: 'right' }}>
                          <div style={{ fontWeight: 700 }}>{fmtMoney(inv.total)}</div>
                          {bal > 0 && <div style={{ color: 'var(--red)', fontSize: '10px' }}>-{fmtMoney(bal)} unpaid</div>}
                          {bal <= 0 && <div style={{ color: 'var(--green)', fontSize: '10px' }}>✓ Paid</div>}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </>
            )}
          </div>
        </div>
      </div>

      {/* ── TOP CLIENTS ── */}
      {clientTotals.length > 0 && (
        <div className="card" style={{ marginTop: '20px' }}>
          <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '16px', marginBottom: '16px' }}>
            🏆 Top Clients by Revenue
          </div>
          {clientTotals.map((c, i) => (
            <div key={c.name} style={{ display: 'flex', alignItems: 'center', gap: '14px', padding: '12px 0', borderBottom: i < clientTotals.length - 1 ? '1px solid #f4f4f0' : 'none' }}>
              <div style={{ width: '28px', height: '28px', borderRadius: '50%', background: 'var(--lime)', display: 'flex', alignItems: 'center', justifyContent: 'center', fontWeight: 800, fontSize: '13px', flexShrink: 0 }}>
                {i + 1}
              </div>
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={{ fontWeight: 700, fontSize: '14px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{c.name}</div>
                <div style={{ fontSize: '11px', color: 'var(--gray)' }}>{c.count} invoice{c.count !== 1 ? 's' : ''}</div>
              </div>
              {/* Revenue bar */}
              <div style={{ flex: 2, display: 'flex', alignItems: 'center', gap: '8px' }}>
                <div style={{ flex: 1, height: '8px', background: '#f0f0ea', borderRadius: '4px', overflow: 'hidden' }}>
                  <div style={{ height: '100%', width: `${(c.total / clientTotals[0].total) * 100}%`, background: 'var(--lime-dark)', borderRadius: '4px', transition: 'width .5s' }} />
                </div>
                <div style={{ fontWeight: 800, fontSize: '13px', minWidth: '80px', textAlign: 'right', color: 'var(--black)' }}>
                  {fmtMoney(c.total)}
                </div>
              </div>
              <div>
                {c.paid >= c.total
                  ? <CheckCircle size={16} color="var(--green)" />
                  : <span style={{ fontSize: '11px', color: 'var(--orange)', fontWeight: 700 }}>-{fmtMoney(c.total - c.paid)}</span>
                }
              </div>
            </div>
          ))}
        </div>
      )}
    </>
  );
}

// Small helper to clamp to 0+
function curb(n) { return Math.max(0, n || 0); }
</file>

<file path="src/views/InvoiceRecordsView.jsx">
import React, { useState } from 'react';
import { useData } from '../store/DataContext';
import { fmtDate } from './DashboardView';
import { CheckCircle, CircleDollarSign, Pencil, X, Check } from 'lucide-react';

export default function InvoiceRecordsView() {
  const { invoices, removeInvoice, updateInvoice } = useData();

  const [editingId, setEditingId] = useState(null);
  const [editPaid, setEditPaid] = useState(0);

  const startEdit = (inv) => {
    setEditingId(inv.id);
    setEditPaid(inv.paid);
  };

  const cancelEdit = () => setEditingId(null);

  // ✅ FIXED: uses proper updateInvoice (patch in-place) instead of delete+add race
  const saveEdit = async (inv) => {
    await updateInvoice(inv.id, { paid: Number(editPaid) });
    setEditingId(null);
  };

  // Date formatter for "April 6, 2026" format
  const fmtSaved = (dateStr) => {
    if (!dateStr) return '—';
    const [y, m, d] = dateStr.split('-').map(Number);
    return new Date(y, m-1, d).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
  };

  const sortedInvoices = [...invoices].sort((a, b) => b.id.localeCompare(a.id));

  return (
    <>
      <div className="ph">
        <div>
          <h2>Invoice Records</h2>
          <p>Tap ✏️ on any row to quickly update the amount paid — no need to rebuild the invoice!</p>
        </div>
      </div>

      {/* MOBILE CARD LAYOUT */}
      <div className="inv-records-mobile" style={{ display: 'none' }}>
        {sortedInvoices.map(inv => {
          const balance = inv.total - inv.paid;
          const isPaid = balance <= 0;
          const isEditing = editingId === inv.id;
          return (
            <div key={inv.id} className="card" style={{ margin: '0 0 12px', borderLeft: `4px solid ${isPaid ? 'var(--green)' : 'var(--orange)'}` }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: '8px' }}>
                <div>
                  <div style={{ fontWeight: 800, fontSize: '15px' }}>{inv.toName}</div>
                  <div style={{ fontSize: '11px', color: 'var(--gray)' }}>{inv.pets}</div>
                </div>
                {isPaid ? (
                  <span style={{ background: '#e6f7ed', color: 'var(--green)', padding: '3px 10px', borderRadius: '20px', fontSize: '11px', fontWeight: 700, display: 'flex', alignItems: 'center', gap: '4px' }}>
                    <CheckCircle size={12} /> PAID
                  </span>
                ) : (
                  <span style={{ background: '#fff4e0', color: 'var(--orange)', padding: '3px 10px', borderRadius: '20px', fontSize: '11px', fontWeight: 700 }}>
                    UNPAID
                  </span>
                )}
              </div>
              <div style={{ fontSize: '12px', color: 'var(--gray)', marginBottom: '10px' }}>{inv.baseServiceName} • {fmtSaved(inv.dateSaved)}</div>
              <div style={{ display: 'flex', gap: '8px', alignItems: 'center', background: '#fafafa', padding: '10px', borderRadius: '8px' }}>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: '11px', fontWeight: 700, color: '#888', marginBottom: '2px' }}>TOTAL</div>
                  <div style={{ fontWeight: 700 }}>₱{inv.total}</div>
                </div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: '11px', fontWeight: 700, color: '#888', marginBottom: '2px' }}>PAID</div>
                  {isEditing ? (
                    <input type="number" value={editPaid} onChange={e => setEditPaid(e.target.value)}
                      style={{ width: '80px', padding: '4px 8px', borderRadius: '6px', border: '2px solid var(--lime-dark)', fontWeight: 700 }} autoFocus />
                  ) : (
                    <div style={{ fontWeight: 700, color: 'var(--green)' }}>₱{inv.paid}</div>
                  )}
                </div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: '11px', fontWeight: 700, color: '#888', marginBottom: '2px' }}>BALANCE</div>
                  <div style={{ fontWeight: 800, color: isPaid ? 'var(--green)' : 'var(--red)' }}>₱{balance}</div>
                </div>
              </div>
              <div style={{ display: 'flex', gap: '6px', marginTop: '10px' }}>
                {isEditing ? (
                  <>
                    <button className="btn btn-xs btn-lime" style={{ flex: 1, justifyContent: 'center' }} onClick={() => saveEdit(inv)}><Check size={14}/> Save</button>
                    <button className="btn btn-xs btn-ghost" onClick={cancelEdit}><X size={14}/></button>
                  </>
                ) : (
                  <>
                    <button className="btn btn-xs btn-ghost" style={{ flex: 1, justifyContent: 'center' }} onClick={() => startEdit(inv)}><Pencil size={13}/> Update Paid</button>
                    <button className="btn btn-xs btn-danger" onClick={() => { if(window.confirm('Delete this record?')) removeInvoice(inv.id); }}>Delete</button>
                  </>
                )}
              </div>
            </div>
          );
        })}
        {sortedInvoices.length === 0 && (
          <div style={{ textAlign: 'center', padding: '50px', background: '#fff', borderRadius: '14px', color: 'var(--gray)' }}>
            <CircleDollarSign size={40} style={{ margin: '0 auto 16px', color: 'var(--lime-dark)' }} />
            <p>No saved invoices yet. Go to Invoice Builder and click 💾 Save Invoice!</p>
          </div>
        )}
      </div>

      {/* DESKTOP TABLE */}
      <div className="inv-records-desktop">
        <div className="card" style={{ padding: 0, overflow: 'hidden' }}>
          <div className="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Date Saved</th>
                  <th>Invoice To</th>
                  <th>Pets</th>
                  <th>Service</th>
                  <th>Total</th>
                  <th>Paid</th>
                  <th>Balance</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {sortedInvoices.length === 0 ? (
                  <tr className="empty-row"><td colSpan="9">No invoices saved yet. Go to Invoice Builder to save one!</td></tr>
                ) : sortedInvoices.map(inv => {
                  const balance = inv.total - inv.paid;
                  const isPaid = balance <= 0;
                  const isEditing = editingId === inv.id;
                  return (
                    <tr key={inv.id} style={{ background: isPaid ? '#f8fff9' : '#fff' }}>
                      <td style={{ fontSize: '12px', color: 'var(--gray)' }}>{fmtSaved(inv.dateSaved)}</td>
                      <td style={{ fontWeight: 'bold' }}>{inv.toName}</td>
                      <td style={{ fontSize: '12px', color: 'var(--gray)', maxWidth: '120px' }}>{inv.pets}</td>
                      <td style={{ fontSize: '12px' }}>{inv.baseServiceName}</td>
                      <td style={{ fontWeight: 700 }}>₱{inv.total}</td>
                      <td>
                        {isEditing ? (
                          <input type="number" value={editPaid}
                            onChange={e => setEditPaid(e.target.value)}
                            style={{ width: '90px', padding: '5px 8px', borderRadius: '6px', border: '2px solid var(--lime-dark)', fontWeight: 700, fontSize: '13px' }}
                            autoFocus
                          />
                        ) : (
                          <span style={{ fontWeight: 600, color: inv.paid > 0 ? 'var(--green)' : '#999' }}>₱{inv.paid}</span>
                        )}
                      </td>
                      <td style={{ fontWeight: 800, color: isPaid ? 'var(--green)' : 'var(--red)' }}>₱{balance}</td>
                      <td>
                        {isPaid
                          ? <span className="badge b-active" style={{ display: 'inline-flex', gap: '4px' }}><CheckCircle size={11} /> Paid</span>
                          : <span className="badge b-pending">Unpaid</span>
                        }
                      </td>
                      <td>
                        <div style={{ display: 'flex', gap: '4px', flexWrap: 'wrap' }}>
                          {isEditing ? (
                            <>
                              <button className="btn btn-xs btn-lime" onClick={() => saveEdit(inv)}><Check size={12}/> Save</button>
                              <button className="btn btn-xs btn-ghost" onClick={cancelEdit}><X size={12}/></button>
                            </>
                          ) : (
                            <>
                              <button className="btn btn-xs btn-ghost" onClick={() => startEdit(inv)} title="Update paid amount">
                                <Pencil size={12}/> Paid
                              </button>
                              <button className="btn btn-xs btn-danger" onClick={() => { if(window.confirm('Delete this record?')) removeInvoice(inv.id); }}>Del</button>
                            </>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <style>{`
        @media (max-width: 768px) {
          .inv-records-mobile { display: block !important; }
          .inv-records-desktop { display: none; }
        }
      `}</style>
    </>
  );
}
</file>

<file path="src/views/InvoiceView.jsx">
import React, { useState, useRef, useEffect } from 'react';
import { useData } from '../store/DataContext';
import html2canvas from 'html2canvas';
import { QRCodeSVG } from 'qrcode.react';

export default function InvoiceView() {
  const { clients, services, addInvoice } = useData();
  const invoiceRef = useRef(null);
  
  const defaultState = {
    gcash: '09952664451',
    clientId: '',
    toName: '',
    pets: '',
    serviceId: services[2]?.id || '',
    days: 1,
    dateRange: '',
    baseDiscount: 0,
    baseDiscountLabel: '',
    extraPets: 0,
    extraPetsDiscount: 0,
    extraPetsDiscountLabel: 'Courtesy Discount',
    paid: 0,
    thanks: 'Thank You Paw! 🐾',
    bgPatternUrl: null,
    topCatUrl: null,
    bottomCatUrl: null
  };
  const [data, setData] = useState(defaultState);

  // Derived state
  useEffect(() => {
    if(data.clientId) {
      const c = clients.find(x => x.id === data.clientId);
      if(c) setData(p => ({ ...p, toName: c.name, pets: c.pets ? c.pets.map(pp => typeof pp === 'string' ? pp : pp.name).join(', ') : '' }));
    }
  }, [data.clientId, clients]);

  const handleImage = (field) => (e) => {
    if(e.target.files && e.target.files[0]) {
      const reader = new FileReader();
      reader.onload = ev => setData({ ...data, [field]: ev.target.result });
      reader.readAsDataURL(e.target.files[0]);
    }
  };

  const getSvc = () => services.find(x => x.id === data.serviceId) || services[0];
  const sPrice = getSvc().price;
  const sName = getSvc().name;
  
  const baseOriginalPrice = sPrice;
  const baseFinalPrice = sPrice - data.baseDiscount;
  const baseAmountOrig = baseOriginalPrice * data.days;
  const baseAmountFinal = baseFinalPrice * data.days;
  
  const extraOrigPrice = data.extraPets * 50; 
  // extraPetsDiscount is a discount on the PER-PET rate, so discounted rate is (50 - discount) per pet
  const extraFinalPricePerDay = Math.max(0, extraOrigPrice - data.extraPetsDiscount);
  const extraAmountOrig = extraOrigPrice * data.days;
  const extraAmountFinal = extraFinalPricePerDay * data.days;
  
  const total = baseAmountFinal + (data.extraPets > 0 ? extraAmountFinal : 0);
  const balance = total - data.paid;

  const handleSaveData = () => {
    addInvoice({
      id: Date.now().toString(),
      dateSaved: new Date().toISOString().split('T')[0],
      toName: data.toName,
      pets: data.pets,
      baseServiceName: sName,
      total,
      paid: data.paid
    });
    alert('Invoice saved to records!');
  };

  const dlRef = () => {
    if(!invoiceRef.current) return;
    html2canvas(invoiceRef.current, { scale: 2, useCORS: true, backgroundColor: null }).then(canvas => {
      const link = document.createElement('a');
      link.download = `Invoice_${data.toName || 'kats'}.png`;
      link.href = canvas.toDataURL("image/png");
      link.click();
    });
  };

  return (
    <>
      <style>{`
        .cv-invoice-wrapper { width: 100%; aspect-ratio: 4/5; background-color: #e5ea90; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; font-family: 'Georgia', serif; color: #111;}
        .cv-bg-layer { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0.3; }
        
        .cv-top-mascot { position: absolute; top: -5%; left: -5%; width: 35%; max-width: 200px; z-index: 10; transform: rotate(15deg); }
        .cv-bot-mascot { position: absolute; bottom: -2%; left: 8%; width: 40%; max-width: 250px; z-index: 10; }
        
        .cv-card { position: relative; z-index: 5; background-color: #efeeee; width: 88%; height: 90%; border-radius: 14px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); padding: 40px 35px; display: flex; flex-direction: column; }
        
        .cv-head { text-align: center; margin-bottom: 30px; }
        .cv-title { font-size: 38px; font-weight: 700; letter-spacing: 2px; }
        .cv-sub { font-size: 18px; font-style: italic; margin-top: 5px; }
        
        .cv-badge { display: inline-block; background-color: #e2e896; border: 2px solid #ccc9b4; border-radius: 20px; padding: 4px 18px; font-family: sans-serif; font-weight: 800; font-size: 14px; margin-top: 10px; color: #111; box-shadow: inset 0 0 0 2px #efeeee; }
        
        .cv-to { font-family: sans-serif; font-size: 13px; line-height: 1.6; margin-bottom: 20px; color: #333; }
        .cv-to strong { display: block; font-size: 12px; letter-spacing: 1px; color: #111; margin-bottom: 4px; }
        
        .cv-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; width: 100%; font-family: sans-serif; font-size: 13px; text-align: center; align-items: center; }
        .cv-grid > div:first-child { text-align: left; padding-left: 10px; }
        
        .cv-th { background-color: #b8b2a8; color: #111; font-weight: 800; padding: 12px 0; margin-bottom: 8px; font-size: 12px; letter-spacing: 1px; border-radius: 2px; }
        
        .cv-tr { border: 1px solid #777; border-radius: 4px; padding: 12px 0; margin-bottom: 6px; }
        
        .cv-sm-gray { font-size: 11px; color: #666; font-style: italic; margin-top: 2px; }
        
        .cv-del { text-decoration: line-through; color: #666; margin-right: 6px; font-size: 12px;}
        .cv-red { color: #cc2222; font-weight: 700; font-size: 10px; display: block; margin-top: 3px; }
        
        .cv-sum { text-align: right; font-family: sans-serif; font-weight: 700; margin-top: 8px; padding-right: 20px; }
        
        .cv-totals { margin-top: 15px; margin-left: auto; width: 180px; font-family: sans-serif; display: flex; flex-direction: column; gap: 6px;}
        .cv-tot-row { background-color: #b8b2a8; padding: 10px 14px; display: flex; justify-content: space-between; font-weight: 700; font-size: 14px; color: #111; border-radius: 2px; }
        
        .cv-arch { position: absolute; bottom: 120px; left: 30px; transform: rotate(-10deg); width: 280px; height: 100px; z-index: 12; }
        .cv-arch text { font-family: 'Georgia', serif; font-weight: 700; font-style: italic; font-size: 28px; }
      `}</style>

      <div className="ph">
        <div>
          <h2>Invoice Builder v2</h2>
          <p>Pixel-perfect graphical invoice editor</p>
        </div>
        <div className="ph-actions">
           <button className="btn btn-ghost no-print" onClick={() => window.print()}>🖨️ Print</button>
           <button className="btn btn-lime no-print" onClick={dlRef}>⬇️ Download as Image</button>
        </div>
      </div>

      <div className="inv-layout">
        <div className="inv-form">
          <div className="if-title">Invoice Content</div>
          
          <div className="form-row">
             <div className="fg"><label>Client</label>
               <select value={data.clientId} onChange={e=>setData({...data, clientId: e.target.value})}>
                  <option value="">— Select client —</option>
                  {clients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
               </select>
             </div>
             <div className="fg"><label>GCash Number</label><input type="text" value={data.gcash} onChange={e=>setData({...data, gcash: e.target.value})} /></div>
          </div>
          
          <div className="form-row">
            <div className="fg"><label>Invoice To (name)</label><input type="text" value={data.toName} onChange={e=>setData({...data, toName: e.target.value})} /></div>
            <div className="fg"><label>Pets Listed</label><input type="text" value={data.pets} onChange={e=>setData({...data, pets: e.target.value})} /></div>
          </div>

          <hr/>
          <div className="fg"><label>Base Service</label>
             <select value={data.serviceId} onChange={e=>setData({...data, serviceId: e.target.value})}>
               {services.map(s => <option key={s.id} value={s.id}>{s.name} — ₱{s.price}/day</option>)}
             </select>
          </div>
          <div className="form-row">
            <div className="fg"><label>Days</label><input type="number" min="1" value={data.days} onChange={e=>setData({...data, days: Number(e.target.value)})} /></div>
            <div className="fg"><label>Date Range text</label><input type="text" value={data.dateRange} onChange={e=>setData({...data, dateRange: e.target.value})} placeholder="Dec 19 - Jan 2" /></div>
          </div>
          <div className="form-row" style={{background:'#fafafa', padding:'10px', borderRadius:'8px', border:'1px solid #ddd'}}>
            <div className="fg" style={{margin:0}}><label>Base Discount (₱/day)</label><input type="number" value={data.baseDiscount} onChange={e=>setData({...data, baseDiscount: Number(e.target.value)})} /></div>
            <div className="fg" style={{margin:0}}><label>Discount Label</label><input type="text" value={data.baseDiscountLabel} onChange={e=>setData({...data, baseDiscountLabel: e.target.value})} /></div>
          </div>

          <hr/>
          <div className="fg">
             <label>Extra Pets (beyond included 2)</label>
             <input type="number" min="0" value={data.extraPets} onChange={e=>setData({...data, extraPets: Number(e.target.value)})} />
             <div className="hint">Base rate is ₱50 per extra pet per day</div>
          </div>
          {data.extraPets > 0 && (
            <div className="form-row" style={{background:'#fafafa', padding:'10px', borderRadius:'8px', border:'1px solid #ddd'}}>
              <div className="fg" style={{margin:0}}><label>Extra Pets Discount (₱/day)</label><input type="number" value={data.extraPetsDiscount} onChange={e=>setData({...data, extraPetsDiscount: Number(e.target.value)})} /></div>
              <div className="fg" style={{margin:0}}><label>Discount Label</label><input type="text" value={data.extraPetsDiscountLabel} onChange={e=>setData({...data, extraPetsDiscountLabel: e.target.value})} /></div>
            </div>
          )}

          <div className="fg"><label>Amount Paid (₱)</label><input type="number" value={data.paid} onChange={e=>setData({...data, paid: Number(e.target.value)})} /></div>
          <div className="fg"><label>Thank You Note</label><input type="text" value={data.thanks} onChange={e=>setData({...data, thanks: e.target.value})} placeholder="Thank You Paw! 🐾" /></div>
          
          <hr/>
          <div className="if-title" style={{fontSize:'14px'}}>Custom Graphics</div>
          <div className="fg"><label>Background Pattern</label><input type="file" accept="image/*" onChange={handleImage('bgPatternUrl')} /></div>
          <div className="form-row">
            <div className="fg"><label>Top Left Mascot</label><input type="file" accept="image/*" onChange={handleImage('topCatUrl')} /></div>
            <div className="fg"><label>Bottom Left Mascot</label><input type="file" accept="image/*" onChange={handleImage('bottomCatUrl')} /></div>
          </div>

          <div style={{display:'flex', gap:'8px', marginTop:'20px'}}>
             <button className="btn btn-lime" style={{flex:1}} onClick={handleSaveData}>💾 Save Invoice</button>
             <button className="btn btn-ghost" onClick={() => setData(defaultState)}>🗑️ Reset</button>
          </div>
        </div>

        {/* INVOICE PREVIEW VISUALIZER */}
        <div style={{borderRadius:'16px', overflow:'hidden', boxShadow:'var(--shadow)'}}>
          <div className="cv-invoice-wrapper" ref={invoiceRef}>
            {data.bgPatternUrl && <div className="cv-bg-layer" style={{backgroundImage: `url(${data.bgPatternUrl})`}}></div>}
            
            {/* Top Cat */}
            {data.topCatUrl ? <img src={data.topCatUrl} className="cv-top-mascot" /> : (
              <svg className="cv-top-mascot" viewBox="0 0 100 100" fill="#111">
                <path d="M10,90 Q20,20 40,30 L30,5 L50,20 L60,0 L70,25 Q90,50 80,90 Z" />
                <circle cx="35" cy="45" r="5" fill="#fff"/>
                <circle cx="65" cy="40" r="5" fill="#fff"/>
              </svg>
            )}

            {/* Bottom Cat */}
            {data.bottomCatUrl ? <img src={data.bottomCatUrl} className="cv-bot-mascot" /> : (
              <svg className="cv-bot-mascot" viewBox="0 0 100 100" fill="#111">
                <path d="M20,100 Q10,60 30,50 Q50,40 70,60 Q90,80 80,100 Z" />
                <circle cx="40" cy="65" r="4" fill="#fff"/>
                <circle cx="60" cy="65" r="4" fill="#fff"/>
                <path d="M0,50 Q10,70 20,50" stroke="#111" strokeWidth="3" fill="transparent" />
                <path d="M100,50 Q90,70 80,50" stroke="#111" strokeWidth="3" fill="transparent" />
              </svg>
            )}

            {/* Curved Text */}
            <svg className="cv-arch" viewBox="0 0 250 80">
              <path id="curve" d="M 10 70 Q 125 10 240 70" fill="transparent" />
              <text>
                <textPath href="#curve" startOffset="50%" textAnchor="middle">{data.thanks}</textPath>
              </text>
            </svg>

            {/* Inner White Box */}
            <div className="cv-card">
              <div className="cv-head">
                 <div className="cv-title">INVOICE</div>
                 <div className="cv-sub">Kat's Pet-sitting Services</div>
                 <div className="cv-badge">GCash: {data.gcash}</div>
                 {data.gcash && (
                   <div style={{ display: 'flex', justifyContent: 'center', marginTop: '8px' }}>
                     <div style={{ background: '#fff', padding: '6px', borderRadius: '8px', display: 'inline-block', boxShadow: '0 1px 6px rgba(0,0,0,0.12)' }}>
                       <QRCodeSVG
                         value={`https://gcash.me/${data.gcash}`}
                         size={72}
                         level="M"
                         includeMargin={false}
                       />
                       <div style={{ fontSize: '8px', textAlign: 'center', color: '#888', marginTop: '3px', fontFamily: 'sans-serif' }}>Scan to pay via GCash</div>
                     </div>
                   </div>
                 )}
              </div>

              <div className="cv-to">
                <strong>INVOICE TO:</strong>
                <div>{data.toName || '—'}</div>
                <div>{data.pets || '—'}</div>
              </div>

              <div className="cv-grid cv-th">
                <div>SERVICE</div><div>DAYS</div><div>PRICE</div><div>AMOUNT</div>
              </div>

              {/* Base Service Row */}
              <div className="cv-grid cv-tr">
                <div>
                  <div style={{fontWeight:500}}>{sName}</div>
                  <div className="cv-sm-gray">(up to 2 pets)</div>
                </div>
                <div>
                  <div>{data.days}</div>
                  <div className="cv-sm-gray">({data.dateRange})</div>
                </div>
                <div>
                  {data.baseDiscount > 0 ? (
                    <><span className="cv-del">{baseOriginalPrice}</span> {baseFinalPrice}<span className="cv-red">{data.baseDiscountLabel}</span></>
                  ) : baseFinalPrice}
                </div>
                <div>
                  {data.baseDiscount > 0 ? (
                    <><span className="cv-del">{baseAmountOrig}</span> {baseAmountFinal}</>
                  ) : baseAmountFinal}
                </div>
              </div>

              {/* Extra Pets Row */}
              {data.extraPets > 0 && (
                <div className="cv-grid cv-tr">
                  <div>
                  <div>Additional {data.extraPets} Pets</div>
                    <div className="cv-sm-gray">(₱50 per add'l pet = ₱{extraOrigPrice}/day)</div>
                  </div>
                  <div>{data.days}</div>
                  <div>
                    {data.extraPetsDiscount > 0 ? (
                      <><span className="cv-del">{extraOrigPrice}</span> {extraFinalPricePerDay}<span className="cv-red">{data.extraPetsDiscountLabel}</span></>
                    ) : extraOrigPrice}
                  </div>
                  <div>
                    {data.extraPetsDiscount > 0 ? (
                      <><span className="cv-del">{extraAmountOrig}</span> {extraAmountFinal}</>
                    ) : extraAmountFinal}
                  </div>
                </div>
              )}

              <div className="cv-sum">{total}</div>

              <div className="cv-totals">
                <div className="cv-tot-row"><span>Paid</span><span>Php {data.paid}</span></div>
                <div className="cv-tot-row"><span>Balance</span><span>Php {balance}</span></div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </>
  );
}
</file>

