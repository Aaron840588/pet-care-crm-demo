import React, { useState } from 'react';
import {
  LayoutDashboard, Users, CalendarDays, TrendingUp,
  KeyRound, FileTerminal, FolderClosed, Settings,
  MoreHorizontal, X
} from 'lucide-react';

// Primary 4 tabs always visible
const primary = [
  { id: 'dashboard', label: 'Home',     Icon: LayoutDashboard },
  { id: 'clients',   label: 'Clients',  Icon: Users },
  { id: 'schedule',  label: 'Schedule', Icon: CalendarDays },
  { id: 'earnings',  label: 'Earnings', Icon: TrendingUp },
];

// "More" drawer contents
const more = [
  { id: 'keys',     label: 'Key Tracker',       Icon: KeyRound },
  { id: 'invoices', label: 'Invoice Builder',   Icon: FileTerminal },
  { id: 'records',  label: 'Invoice Records',   Icon: FolderClosed },
  { id: 'settings', label: 'Settings & Backup', Icon: Settings },
];

const moreIds = more.map(m => m.id);

export default function BottomNav({ activeTab, setActiveTab }) {
  const [drawerOpen, setDrawerOpen] = useState(false);

  const goTo = (id) => {
    setActiveTab(id);
    setDrawerOpen(false);
  };

  const moreIsActive = moreIds.includes(activeTab);

  return (
    <>
      {/* Drawer overlay */}
      {drawerOpen && (
        <div
          style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.45)', zIndex: 298 }}
          onClick={() => setDrawerOpen(false)}
        />
      )}

      {/* More drawer */}
      {drawerOpen && (
        <div style={{
          position: 'fixed', bottom: `calc(64px + var(--safe-bottom))`,
          left: '50%', transform: 'translateX(-50%)',
          background: '#1a1a1a', borderRadius: '20px',
          padding: '16px', width: 'calc(100vw - 32px)', maxWidth: '400px',
          zIndex: 299, boxShadow: '0 -4px 40px rgba(0,0,0,0.4)',
          display: 'flex', flexDirection: 'column', gap: '4px'
        }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '10px' }}>
            <span style={{ color: '#666', fontSize: '11px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '.06em' }}>More Sections</span>
            <button onClick={() => setDrawerOpen(false)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#666', padding: '4px' }}>
              <X size={18} />
            </button>
          </div>
          {more.map(({ id, label, Icon }) => (
            <button
              key={id}
              onClick={() => goTo(id)}
              style={{
                display: 'flex', alignItems: 'center', gap: '14px',
                padding: '13px 16px', borderRadius: '12px', border: 'none',
                background: activeTab === id ? 'rgba(212,232,74,0.15)' : 'transparent',
                color: activeTab === id ? 'var(--lime)' : '#aaa',
                cursor: 'pointer', fontFamily: 'var(--font-body)', fontSize: '14px',
                fontWeight: activeTab === id ? 700 : 500,
                textAlign: 'left', width: '100%',
                WebkitTapHighlightColor: 'transparent'
              }}
            >
              <Icon size={20} />
              {label}
            </button>
          ))}
        </div>
      )}

      {/* Bottom nav bar */}
      <nav className="bottom-nav">
        {primary.map(({ id, label, Icon }) => (
          <button
            key={id}
            className={`bn-item ${activeTab === id ? 'active' : ''}`}
            onClick={() => goTo(id)}
          >
            <Icon size={20} />
            <span>{label}</span>
          </button>
        ))}
        {/* More button */}
        <button
          className={`bn-item ${moreIsActive ? 'active' : ''}`}
          onClick={() => setDrawerOpen(d => !d)}
        >
          <MoreHorizontal size={20} />
          <span>{moreIsActive ? more.find(m => m.id === activeTab)?.label.split(' ')[0] : 'More'}</span>
        </button>
      </nav>
    </>
  );
}
</file>

<file path="src/components/Sidebar.jsx">
import React from 'react';
import {
  LayoutDashboard, Users, CalendarDays, KeyRound,
  FileTerminal, FolderClosed, Settings, TrendingUp
} from 'lucide-react';

export default function Sidebar({ activeTab, setActiveTab, isMobileOpen, setMobileOpen }) {
  const navItems = [
    { section: 'Overview' },
    { id: 'dashboard', label: 'Dashboard',       icon: LayoutDashboard },
    { section: 'Manage' },
    { id: 'clients',  label: 'Clients',           icon: Users },
    { id: 'schedule', label: 'Schedule',          icon: CalendarDays },
    { id: 'keys',     label: 'Key Tracker',       icon: KeyRound },
    { section: 'Billing' },
    { id: 'invoices', label: 'Invoice Builder',   icon: FileTerminal },
    { id: 'records',  label: 'Invoice Records',   icon: FolderClosed },
    { id: 'earnings', label: 'Earnings Summary',  icon: TrendingUp },
    { section: 'System' },
    { id: 'settings', label: 'Settings & Backup', icon: Settings },
  ];

  const handleNav = (id) => {
    setActiveTab(id);
    setMobileOpen(false);
  };

  return (
    <div className={`sidebar ${isMobileOpen ? 'open' : ''}`}>
      <div className="sb-brand">
        <div className="logo">Kat's <span>Pet-sitting</span></div>
        <div className="sub">Business Manager 🐾</div>
      </div>

      <nav className="nav">
        {navItems.map((item, idx) =>
          item.section
            ? <div key={`sec-${idx}`} className="nav-section">{item.section}</div>
            : (
              <div
                key={item.id}
                className={`nav-item ${activeTab === item.id ? 'active' : ''}`}
                onClick={() => handleNav(item.id)}
                role="button"
                tabIndex={0}
                onKeyDown={e => e.key === 'Enter' && handleNav(item.id)}
              >
                <div className="ic"><item.icon size={16} /></div>
                {item.label}
              </div>
            )
        )}
      </nav>

      <div className="sb-footer">
        Kat's Pet-sitting Services<br />
        San Antonio, Los Baños, Laguna<br />
        GCash: 09952664451
      </div>
    </div>
  );
}
