<file path="src/views/ScheduleView.jsx">
import React, { useState } from 'react';
import { useData } from '../store/DataContext';
import { Clock, Pencil, Copy, Eye, X } from 'lucide-react';
import { fmtDate } from './DashboardView';

export default function ScheduleView() {
  const { bookings, addBooking, updateBooking, removeBooking, clients, services } = useData();
  const [modalOpen, setModalOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [filter, setFilter] = useState('all');
  const [viewBooking, setViewBooking] = useState(null); // Feature 7: Visit Quick-View

  const getDefaultService = () => {
    if (services.length === 0) return '';
    const s = services[0];
    return `${s.name}|${s.price}`;
  };

  const defaultBooking = {
    clientId: '',
    service: '',
    startDate: '',
    endDate: '',
    extraPets: 0,
    status: 'pending',
    timeText: '',
    notes: ''
  };
  const [formData, setFormData] = useState(defaultBooking);

  const openAdd = () => {
    setFormData({ ...defaultBooking, service: getDefaultService() });
    setEditingId(null);
    setModalOpen(true);
  };

  const openEdit = (booking) => {
    setFormData({
      clientId: booking.clientId || '',
      service: booking.service || getDefaultService(),
      startDate: booking.startDate || '',
      endDate: booking.endDate || '',
      extraPets: booking.extraPets || 0,
      status: booking.status || 'pending',
      timeText: booking.timeText || '',
      notes: booking.notes || ''
    });
    setEditingId(booking.id);
    setModalOpen(true);
  };

  const handleSave = (e) => {
    e.preventDefault();
    if (!formData.clientId || !formData.startDate || !formData.endDate) return;

    const client = clients.find(c => c.id === formData.clientId);
    const clientName = client ? client.name : 'Unknown';
    const numDays = Math.max(1,
      Math.ceil((new Date(formData.endDate) - new Date(formData.startDate)) / (1000 * 60 * 60 * 24)) + 1
    );

    const parts = formData.service.split('|');
    const servicePrice = Number(parts[1]) || 0;
    const extraPetCost = formData.extraPets * 50;
    const total = (servicePrice + extraPetCost) * numDays;

    if (editingId) {
      updateBooking(editingId, { ...formData, clientName, days: numDays, total });
    } else {
      addBooking({ ...formData, clientName, days: numDays, total });
    }
    setModalOpen(false);
  };

  // Quick status cycle: pending → active → done → pending
  const cycleStatus = (booking) => {
    const next = booking.status === 'pending' ? 'active'
      : booking.status === 'active' ? 'done' : 'pending';
    updateBooking(booking.id, { status: next });
  };

  // Clone: pre-fill modal with all fields except dates, set as new booking
  const cloneBooking = (booking) => {
    setFormData({
      clientId: booking.clientId || '',
      service: booking.service || getDefaultService(),
      startDate: '',
      endDate: '',
      extraPets: booking.extraPets || 0,
      status: 'pending',
      timeText: booking.timeText || '',
      notes: booking.notes || ''
    });
    setEditingId(null);
    setModalOpen(true);
  };

  const getStatusBadge = (status) => {
    if (status === 'active') return <span className="badge b-active" style={{ cursor: 'pointer' }}>● Active</span>;
    if (status === 'pending') return <span className="badge b-pending" style={{ cursor: 'pointer' }}>● Upcoming</span>;
    return <span className="badge b-done" style={{ cursor: 'pointer' }}>✓ Done</span>;
  };

  const displayTime = (b) => b.timeText || b.flexNote || 'Any Time';

  const appendTimeText = (text) => {
    const current = formData.timeText ? formData.timeText.trim() + ', ' : '';
    setFormData({ ...formData, timeText: current + text });
  };

  const filteredBookings = bookings
    .filter(b => filter === 'all' ? true : b.status === filter)
    .sort((a, b) => new Date(a.startDate) - new Date(b.startDate));

  return (
    <>
      <div className="ph">
        <div>
          <h2>Schedule</h2>
          <p>All bookings and pet-sitting sessions — tap a status badge to change it instantly</p>
        </div>
        <div className="ph-actions">
          <button className="btn btn-lime" onClick={openAdd}>+ Add Booking</button>
        </div>
      </div>

      <div className="filter-bar">
        {['all', 'active', 'pending', 'done'].map(f => (
          <button key={f} className={`fchip ${filter === f ? 'active' : ''}`} onClick={() => setFilter(f)}>
            {f === 'pending' ? 'Upcoming' : f.charAt(0).toUpperCase() + f.slice(1)}
          </button>
        ))}
      </div>

      <div className="card" style={{ padding: 0, overflow: 'hidden' }}>
        <div className="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Client</th>
                <th>Service</th>
                <th>Dates</th>
                <th>Time</th>
                <th>Days</th>
                <th>Total</th>
                <th>Status (tap to change)</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {filteredBookings.length === 0 ? (
                <tr className="empty-row"><td colSpan="8">No bookings found</td></tr>
              ) : filteredBookings.map(b => (
                <tr key={b.id}>
                  <td style={{ fontWeight: 'bold' }}>{b.clientName}</td>
                  <td>
                    {b.service.split('|')[0]}
                    {b.extraPets > 0 && <span style={{ display: 'block', color: 'var(--gray)', fontSize: '10px' }}>(+{b.extraPets} extra pets)</span>}
                  </td>
                  <td style={{ fontSize: '12px', lineHeight: 1.5 }}>
                    <span style={{ fontWeight: 600 }}>{fmtDate(b.startDate)}</span>
                    <br /><span style={{ color: 'var(--gray)' }}>to</span><br />
                    <span style={{ fontWeight: 600 }}>{fmtDate(b.endDate)}</span>
                  </td>
                  <td>
                    <span className="time-flex">
                      <Clock size={12} style={{ marginRight: '4px', marginBottom: '-2px' }} />
                      {displayTime(b)}
                    </span>
                  </td>
                  <td>{b.days}</td>
                  <td style={{ fontWeight: 'bold' }}>₱{b.total}</td>
                  <td onClick={() => cycleStatus(b)} title="Tap to change status">
                    {getStatusBadge(b.status)}
                  </td>
                  <td>
                    <div style={{ display: 'flex', gap: '4px' }}>
                      <button className="btn btn-xs btn-ghost" onClick={() => setViewBooking(b)} title="Quick view">
                        <Eye size={11} /> View
                      </button>
                      <button className="btn btn-xs btn-ghost" onClick={() => openEdit(b)} title="Edit booking">
                        <Pencil size={11} /> Edit
                      </button>
                      <button className="btn btn-xs btn-ghost" onClick={() => cloneBooking(b)} title="Clone this booking">
                        <Copy size={11} /> Clone
                      </button>
                      <button className="btn btn-xs btn-danger" onClick={() => {
                        if (window.confirm('Delete this booking?')) removeBooking(b.id);
                      }}>Del</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {modalOpen && (
        <div className="overlay open">
          <div className="modal">
            <div className="modal-title">{editingId ? 'Edit Booking' : 'Add Booking'}</div>
            <form onSubmit={handleSave}>
              <div className="fg"><label>Client *</label>
                <select required value={formData.clientId} onChange={e => setFormData({ ...formData, clientId: e.target.value })}>
                  <option value="">— Select client —</option>
                  {clients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                </select>
              </div>

              <div className="fg"><label>Service *</label>
                <select required value={formData.service} onChange={e => setFormData({ ...formData, service: e.target.value })}>
                  {services.map(s => <option key={s.id} value={`${s.name}|${s.price}`}>{s.name} — ₱{s.price}/day</option>)}
                </select>
              </div>

              <div className="form-row">
                <div className="fg"><label>Start Date *</label>
                  <input required type="date" value={formData.startDate} onChange={e => setFormData({ ...formData, startDate: e.target.value })} />
                </div>
                <div className="fg"><label>End Date *</label>
                  <input required type="date" value={formData.endDate} onChange={e => setFormData({ ...formData, endDate: e.target.value })} />
                </div>
              </div>

              <div className="form-row">
                <div className="fg"><label>Extra Pets (above included)</label>
                  <input type="number" min="0" value={formData.extraPets} onChange={e => setFormData({ ...formData, extraPets: Number(e.target.value) })} />
                  <div className="hint">₱50 per extra pet per day added automatically</div>
                </div>
                <div className="fg"><label>Status</label>
                  <select value={formData.status} onChange={e => setFormData({ ...formData, status: e.target.value })}>
                    <option value="pending">Upcoming</option>
                    <option value="active">Active (ongoing)</option>
                    <option value="done">Done</option>
                  </select>
                </div>
              </div>

              {/* QUICK-FILL TIME */}
              <div className="fg" style={{ background: '#f8f8f8', padding: '14px', borderRadius: '10px', border: '1px solid #eee' }}>
                <label>Visit Time & Logistics</label>
                <input
                  type="text"
                  value={formData.timeText}
                  onChange={e => setFormData({ ...formData, timeText: e.target.value })}
                  placeholder="e.g. 8:00 AM, Flexible Morning"
                />
                <div style={{ display: 'flex', gap: '6px', flexWrap: 'wrap', marginTop: '10px' }}>
                  {['Morning', 'Afternoon', 'Evening', '7:00 AM', '8:00 AM', '9:00 AM', '5:00 PM', '6:00 PM', 'Flexible', '2x a day'].map(chip => (
                    <button key={chip} type="button" className="btn btn-xs btn-ghost"
                      onClick={() => appendTimeText(chip)}
                      style={{ fontSize: '11px', borderRadius: '20px', backgroundColor: '#fff' }}>
                      + {chip}
                    </button>
                  ))}
                </div>
              </div>

              <div className="fg"><label>Special Instructions</label>
                <textarea value={formData.notes} onChange={e => setFormData({ ...formData, notes: e.target.value })}
                  placeholder="Feeding schedule, locked gates, medicine, etc." />
              </div>

              {/* COST PREVIEW */}
              {formData.startDate && formData.endDate && formData.service && (() => {
                const parts = formData.service.split('|');
                const price = Number(parts[1]) || 0;
                const days = Math.max(1, Math.ceil((new Date(formData.endDate) - new Date(formData.startDate)) / 86400000) + 1);
                const total = (price + formData.extraPets * 50) * days;
                return (
                  <div style={{ background: 'var(--lime-pale)', borderRadius: '10px', padding: '12px 16px', marginBottom: '14px', fontSize: '13px' }}>
                    <div style={{ fontWeight: 700, marginBottom: '4px' }}>💰 Cost Preview</div>
                    <div style={{ color: '#555' }}>{days} day{days !== 1 ? 's' : ''} × ₱{price + formData.extraPets * 50}/day = <strong>₱{total}</strong></div>
                  </div>
                );
              })()}

              <div className="modal-actions">
                <button type="button" className="btn btn-ghost" onClick={() => setModalOpen(false)}>Cancel</button>
                <button type="submit" className="btn btn-lime">{editingId ? 'Save Changes' : 'Add Booking'}</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* FEATURE 7: Visit Quick-View Modal */}
      {viewBooking && (() => {
        const vb = viewBooking;
        const client = clients.find(c => c.clientId === vb.clientId || c.id === vb.clientId);
        return (
          <div className="overlay open" onClick={() => setViewBooking(null)}>
            <div className="modal" onClick={e => e.stopPropagation()}>
              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '20px' }}>
                <div style={{ fontFamily: 'var(--font-display)', fontSize: '20px', fontWeight: 700 }}>
                  🐾 Visit Details
                </div>
                <button onClick={() => setViewBooking(null)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'var(--gray)' }}>
                  <X size={22} />
                </button>
              </div>

              {/* Client + dates hero */}
              <div style={{ background: 'var(--black)', borderRadius: '14px', padding: '20px', marginBottom: '16px', color: '#fff', textAlign: 'center' }}>
                <div style={{ fontFamily: 'var(--font-display)', fontSize: '26px', fontWeight: 700, color: 'var(--lime)' }}>{vb.clientName}</div>
                <div style={{ fontSize: '13px', color: '#aaa', marginTop: '4px' }}>
                  {fmtDate(vb.startDate)} → {fmtDate(vb.endDate)} · {vb.days} day{vb.days !== 1 ? 's' : ''}
                </div>
                <div style={{ marginTop: '10px' }}>
                  {getStatusBadge(vb.status)}
                </div>
              </div>

              {/* Service + time */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px', marginBottom: '14px' }}>
                <div style={{ background: '#f8f8f8', borderRadius: '10px', padding: '14px', textAlign: 'center' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: 'var(--gray)', marginBottom: '4px' }}>Service</div>
                  <div style={{ fontWeight: 700, fontSize: '14px' }}>{vb.service?.split('|')[0] || '—'}</div>
                </div>
                <div style={{ background: '#f8f8f8', borderRadius: '10px', padding: '14px', textAlign: 'center' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: 'var(--gray)', marginBottom: '4px' }}>Time</div>
                  <div style={{ fontWeight: 700, fontSize: '14px' }}>{displayTime(vb)}</div>
                </div>
              </div>

              {/* Address */}
              {client?.address && (
                <div style={{ background: 'var(--lime-pale)', borderRadius: '10px', padding: '14px', marginBottom: '14px' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: '#555', marginBottom: '4px' }}>📍 Address</div>
                  <div style={{ fontWeight: 600, fontSize: '15px' }}>{client.address}</div>
                </div>
              )}

              {/* Pets */}
              {client?.pets && client.pets.length > 0 && (
                <div style={{ background: '#f8f8f8', borderRadius: '10px', padding: '14px', marginBottom: '14px' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: '#555', marginBottom: '8px' }}>🐱 Pets</div>
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px' }}>
                    {client.pets.map((p, i) => (
                      <span key={i} style={{ background: '#fff', border: '1.5px solid #ddd', borderRadius: '20px', padding: '4px 12px', fontSize: '13px', fontWeight: 600 }}>
                        {typeof p === 'string' ? p : p.name}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {/* Client notes */}
              {client?.notes && (
                <div style={{ background: '#fffef5', border: '1.5px solid var(--lime)', borderRadius: '10px', padding: '14px', marginBottom: '14px' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: '#555', marginBottom: '6px' }}>📋 Special Instructions</div>
                  <div style={{ fontSize: '14px', lineHeight: 1.6 }}>{client.notes}</div>
                </div>
              )}

              {/* Booking notes */}
              {vb.notes && (
                <div style={{ background: '#f0f4ff', borderRadius: '10px', padding: '14px', marginBottom: '14px' }}>
                  <div style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', color: '#555', marginBottom: '6px' }}>📝 Booking Notes</div>
                  <div style={{ fontSize: '14px', lineHeight: 1.6 }}>{vb.notes}</div>
                </div>
              )}

              <button className="btn btn-dark" style={{ width: '100%', justifyContent: 'center' }} onClick={() => setViewBooking(null)}>
                Close
              </button>
            </div>
          </div>
        );
      })()}
    </>
  );
}
</file>

<file path="src/views/SettingsView.jsx">
import React, { useRef, useState } from 'react';
import { useData } from '../store/DataContext';
import { Download, Upload, DatabaseZap, Plus, Pencil, Trash2, Check, X, Wifi, WifiOff } from 'lucide-react';

export default function SettingsView() {
  const { exportData, importData, services, setServices, syncStatus } = useData();
  const fileInputRef = useRef(null);

  // ── Service editor state ──────────────────────────────────────────────────
  const [editingId, setEditingId] = useState(null);
  const [editName, setEditName] = useState('');
  const [editPrice, setEditPrice] = useState('');
  const [editSub, setEditSub] = useState('');
  const [adding, setAdding] = useState(false);
  const [newName, setNewName] = useState('');
  const [newPrice, setNewPrice] = useState('');
  const [newSub, setNewSub] = useState('up to 2 pets');

  const startEdit = (svc) => {
    setEditingId(svc.id);
    setEditName(svc.name);
    setEditPrice(String(svc.price));
    setEditSub(svc.defaultSub || '');
    setAdding(false);
  };

  const saveEdit = () => {
    if (!editName.trim() || !editPrice) return;
    setServices(prev => prev.map(s =>
      s.id === editingId
        ? { ...s, name: editName.trim(), price: Number(editPrice), defaultSub: editSub.trim() }
        : s
    ));
    setEditingId(null);
  };

  const deleteService = (id) => {
    if (services.length <= 1) { alert('You must keep at least one service.'); return; }
    if (window.confirm('Delete this service?')) {
      setServices(prev => prev.filter(s => s.id !== id));
    }
  };

  const saveNew = () => {
    if (!newName.trim() || !newPrice) return;
    const newId = Date.now().toString();
    setServices(prev => [...prev, {
      id: newId,
      name: newName.trim(),
      price: Number(newPrice),
      defaultSub: newSub.trim()
    }]);
    setNewName(''); setNewPrice(''); setNewSub('up to 2 pets');
    setAdding(false);
  };

  const handleFileChange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => importData(ev.target.result);
    reader.readAsText(file);
    e.target.value = null;
  };

  return (
    <>
      <div className="ph">
        <div>
          <h2>Settings</h2>
          <p>Manage your services, prices, and data backups</p>
        </div>
      </div>

      <div style={{ maxWidth: '680px', margin: '0 auto', display: 'flex', flexDirection: 'column', gap: '20px' }}>

        {/* ── SYNC STATUS ── */}
        <div className="card" style={{ margin: 0, display: 'flex', alignItems: 'center', gap: '14px', padding: '18px 22px' }}>
          <div style={{
            background: syncStatus === 'online' ? '#e6f7ed' : '#fff4e0',
            borderRadius: '10px', padding: '10px', flexShrink: 0
          }}>
            {syncStatus === 'online'
              ? <Wifi size={22} color="var(--green)" />
              : <WifiOff size={22} color="var(--orange)" />
            }
          </div>
          <div>
            <div style={{ fontWeight: 700, fontSize: '14px' }}>
              {syncStatus === 'online' ? '🟢 Live — Syncing to Cloud' : '🟡 Offline — Changes saved locally'}
            </div>
            <div style={{ fontSize: '12px', color: 'var(--gray)', marginTop: '2px' }}>
              {syncStatus === 'online'
                ? 'Any device opening this app will see the same data.'
                : 'Data will auto-sync to all devices when internet returns.'}
            </div>
          </div>
        </div>

        {/* ── SERVICES EDITOR ── */}
        <div className="card" style={{ margin: 0, padding: 0, overflow: 'hidden' }}>
          <div style={{ padding: '20px 22px 16px', borderBottom: '1px solid #f0f0ee' }}>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '8px' }}>
              <div>
                <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '16px' }}>🛎 My Services & Prices</div>
                <div style={{ fontSize: '12px', color: 'var(--gray)', marginTop: '2px' }}>
                  These show up in the Schedule booking form and invoices.
                </div>
              </div>
              {!adding && (
                <button className="btn btn-lime btn-sm" onClick={() => { setAdding(true); setEditingId(null); }}>
                  <Plus size={14} /> Add Service
                </button>
              )}
            </div>
          </div>

          {/* Add new service row */}
          {adding && (
            <div style={{ background: 'var(--lime-pale)', padding: '16px 22px', borderBottom: '1px solid #dde8a0' }}>
              <div style={{ fontWeight: 700, fontSize: '12px', textTransform: 'uppercase', letterSpacing: '.04em', marginBottom: '10px', color: '#555' }}>
                New Service
              </div>
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 120px', gap: '10px', marginBottom: '10px' }}>
                <div className="fg" style={{ margin: 0 }}>
                  <label>Service Name *</label>
                  <input value={newName} onChange={e => setNewName(e.target.value)}
                    placeholder="e.g. Overnight Stay" autoFocus />
                </div>
                <div className="fg" style={{ margin: 0 }}>
                  <label>Price (₱/day) *</label>
                  <input type="number" min="1" value={newPrice} onChange={e => setNewPrice(e.target.value)}
                    placeholder="e.g. 500" />
                </div>
              </div>
              <div className="fg" style={{ margin: '0 0 12px' }}>
                <label>Description (optional)</label>
                <input value={newSub} onChange={e => setNewSub(e.target.value)}
                  placeholder="e.g. up to 3 pets" />
              </div>
              <div style={{ display: 'flex', gap: '8px' }}>
                <button className="btn btn-lime btn-sm" onClick={saveNew}>
                  <Check size={14} /> Save Service
                </button>
                <button className="btn btn-ghost btn-sm" onClick={() => setAdding(false)}>
                  <X size={14} /> Cancel
                </button>
              </div>
            </div>
          )}

          {/* Services list */}
          {services.map((svc, idx) => (
            <div key={svc.id} style={{
              padding: '16px 22px',
              borderBottom: idx < services.length - 1 ? '1px solid #f4f4f0' : 'none',
              background: editingId === svc.id ? '#fffef5' : '#fff'
            }}>
              {editingId === svc.id ? (
                // Edit mode
                <div>
                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 120px', gap: '10px', marginBottom: '10px' }}>
                    <div className="fg" style={{ margin: 0 }}>
                      <label>Service Name</label>
                      <input value={editName} onChange={e => setEditName(e.target.value)} autoFocus />
                    </div>
                    <div className="fg" style={{ margin: 0 }}>
                      <label>Price (₱/day)</label>
                      <input type="number" min="1" value={editPrice} onChange={e => setEditPrice(e.target.value)} />
                    </div>
                  </div>
                  <div className="fg" style={{ margin: '0 0 12px' }}>
                    <label>Description</label>
                    <input value={editSub} onChange={e => setEditSub(e.target.value)} />
                  </div>
                  <div style={{ display: 'flex', gap: '8px' }}>
                    <button className="btn btn-lime btn-sm" onClick={saveEdit}>
                      <Check size={14} /> Save Changes
                    </button>
                    <button className="btn btn-ghost btn-sm" onClick={() => setEditingId(null)}>
                      <X size={14} /> Cancel
                    </button>
                  </div>
                </div>
              ) : (
                // View mode
                <div style={{ display: 'flex', alignItems: 'center', gap: '14px' }}>
                  <div style={{
                    background: 'var(--lime)', borderRadius: '10px',
                    padding: '10px 14px', fontWeight: 800, fontSize: '15px',
                    minWidth: '80px', textAlign: 'center', flexShrink: 0
                  }}>
                    ₱{svc.price}
                    <div style={{ fontWeight: 500, fontSize: '9px', color: '#555', marginTop: '1px' }}>/day</div>
                  </div>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontWeight: 700, fontSize: '14px' }}>{svc.name}</div>
                    {svc.defaultSub && (
                      <div style={{ fontSize: '11px', color: 'var(--gray)', marginTop: '2px' }}>{svc.defaultSub}</div>
                    )}
                  </div>
                  <div style={{ display: 'flex', gap: '6px', flexShrink: 0 }}>
                    <button className="btn btn-xs btn-ghost" onClick={() => startEdit(svc)} title="Edit">
                      <Pencil size={12} />
                    </button>
                    <button className="btn btn-xs btn-danger" onClick={() => deleteService(svc.id)} title="Delete">
                      <Trash2 size={12} />
                    </button>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        {/* ── BACKUP MODULE ── */}
        <div className="card" style={{ margin: 0 }}>
          <div style={{ fontFamily: 'var(--font-display)', fontWeight: 700, fontSize: '16px', marginBottom: '6px' }}>
            📦 Data Backup
          </div>
          <p style={{ fontSize: '13px', color: 'var(--gray)', lineHeight: 1.6, marginBottom: '20px' }}>
            Your data lives in the cloud (Firebase). As an extra safety net, you can export a local copy as a <code>.json</code> file and restore it at any time.
          </p>
          <div style={{ display: 'flex', gap: '12px', flexWrap: 'wrap' }}>
            <button className="btn btn-lime" style={{ flex: 1, justifyContent: 'center', minWidth: '140px' }} onClick={exportData}>
              <Download size={18} /> Export Backup
            </button>
            <button className="btn btn-ghost" style={{ flex: 1, justifyContent: 'center', minWidth: '140px' }} onClick={() => fileInputRef.current.click()}>
              <Upload size={18} /> Import Backup
            </button>
          </div>
          <input type="file" accept=".json" ref={fileInputRef} onChange={handleFileChange} style={{ display: 'none' }} />
        </div>

        {/* ── APP INFO ── */}
        <div style={{ textAlign: 'center', padding: '10px', color: 'var(--gray)', fontSize: '11px', lineHeight: 1.6 }}>
          Kat's Pet-sitting CRM 🐾<br/>
          San Antonio, Los Baños, Laguna<br/>
          GCash: 09952664451
        </div>

      </div>
    </>
  );
}
</file>

